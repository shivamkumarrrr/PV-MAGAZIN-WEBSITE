---
import BaseLayout from "./BaseLayout.astro";
import RechnerCta from "../components/RechnerCta.astro";
import ArticleFaq from "../components/ArticleFaq.astro";
import ArticleHero from "../components/ArticleHero.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import VerwandteArtikel from "../components/VerwandteArtikel.astro";
import { categoryLabel } from "../lib/categories.js";
import { rechnerBySlug } from "../lib/rechner.js";

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  datePublished: Date;
  dateModified: Date;
  relatedRechner: string;
  rechnerText?: string;
  ogImage?: string;
  heroImage?: string;
  heroImageAlt?: string;
  faq?: { frage: string; antwort: string }[];
  zusammenfassung?: string[];
  vorgehen?: string[];
  // Überschriften aus render() (astro:content): Grundlage der Inhaltsangabe.
  // Bewusst aus dem echten Rendering statt aus dem Frontmatter — die TOC kann
  // so nie gegen den sichtbaren Text auseinanderlaufen (gleiche Regel wie FAQ).
  headings?: { depth: number; slug: string; text: string }[];
  lesedauer?: number;
}

const {
  slug,
  title,
  description,
  category,
  datePublished,
  dateModified,
  relatedRechner,
  rechnerText,
  ogImage,
  heroImage,
  heroImageAlt,
  faq,
  zusammenfassung,
  vorgehen,
  headings,
  lesedauer,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const catLabel = categoryLabel(category);

// Text der Abschlussbox: was DIESER Rechner tut. Vorher stand für alle elf
// Rechner derselbe Standardsatz "Ertrag, Ersparnis und Amortisation für Ihr
// eigenes Dach" — auch unter CO₂-, Steuer- und Reinigungsrechner, die nichts
// davon berechnen.
const abschlussText = rechnerText ?? rechnerBySlug(relatedRechner)?.beschreibung;

const datumFormat = (d: Date) =>
  d.toLocaleDateString("de-DE", { day: "2-digit", month: "long", year: "numeric" });

// Aktualisierungsdatum nur zeigen, wenn es sich vom Veröffentlichungsdatum
// unterscheidet — sonst steht zweimal dasselbe da.
const wurdeAktualisiert = dateModified.getTime() !== datePublished.getTime();

// Nur h2/h3 wandern in die Inhaltsangabe; die H1 steht schon als Titel darüber.
const inhaltsangabe = (headings ?? [])
  .filter((h) => h.depth >= 2 && h.slug)
  .map((h) => ({ ...h, li: h.depth === 3 }));

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: datePublished.toISOString(),
  dateModified: dateModified.toISOString(),
  // Ohne Autoren-Byline (bewusste Nutzerentscheidung, siehe CLAUDE.md) ist die
  // Organisation der Urheber — erfundene Autorennamen wären ein Verstoß gegen
  // die Projektregeln. `author` fehlte vorher komplett; Google erwartet das Feld.
  author: { "@type": "Organization", name: "Photovoltaik Aktuell" },
  publisher: { "@type": "Organization", name: "Photovoltaik Aktuell" },
  mainEntityOfPage: canonicalURL.toString(),
  ...(ogImage ? { image: new URL(ogImage, Astro.site).toString() } : {}),
};


// FAQPage aus denselben Daten wie der sichtbare Block (ArticleFaq.astro) —
// Google verlangt, dass strukturierte Daten dem sichtbaren Text entsprechen.
const faqLd =
  faq && faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.frage,
          acceptedAnswer: { "@type": "Answer", text: f.antwort },
        })),
      }
    : null;
---

<BaseLayout title={`${title} | Photovoltaik Aktuell`} description={description} ogImage={ogImage} bodyClass="seite-artikel">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  {/* Lesefortschritt: dünne Linie am oberen Rand, reines CSS über eine
      Scroll-Timeline. Ohne Browserunterstützung bleibt sie unsichtbar. */}
  <div class="lesefortschritt" aria-hidden="true"></div>

  <article class="prose article">
    {/* Kopfband: dasselbe lebende Punktraster wie im Hero der Startseite
        (src/lib/heroPunkte.js), nur hinter dem Titelblock und leiser. Der
        Fließtext bleibt ruhig — Bewegung neben einem Absatz kostet Lesbarkeit. */}
    <header class="artikel-kopf">
    <canvas class="artikel-punkte" aria-hidden="true"></canvas>
    {/* Das letzte Glied ist der Artikel selbst. Vorher endete die Kette bei
        der Kategorie, und darunter stand derselbe Kategoriename noch einmal
        als Eyebrow-Label — dieselbe Information zweimal, und das
        Kleinversalien-Label ist zudem ein bekannter Generierungs-Tell (siehe
        index.astro). Der Eyebrow ist deshalb weg, die Brotkrume trägt die
        Einordnung. */}
    <Breadcrumb
      glieder={[
        { name: "Ratgeber", href: "/ratgeber/" },
        { name: catLabel, href: `/ratgeber/${category}/` },
        { name: title },
      ]}
    />

    <h1>{title}</h1>
    <p class="lede">{description}</p>

    <p class="meta">
      Veröffentlicht am <time datetime={datePublished.toISOString()}>{datumFormat(datePublished)}</time>
      {wurdeAktualisiert && (
        <> · Aktualisiert am <time datetime={dateModified.toISOString()}>{datumFormat(dateModified)}</time></>
      )}
      {lesedauer ? <span class="meta-sep" aria-hidden="true">·</span> : null}
      {lesedauer && <span>Ca. {lesedauer} Min. Lesezeit</span>}
    </p>
    </header>

    <ArticleHero heroImage={heroImage} heroImageAlt={heroImageAlt} />

    {/* Kernsätze VOR dem Text statt am Ende (Muster: Finanztip "Das Wichtigste
        in Kürze", Carbon Brief). Wer nur die Antwort sucht, hat sie nach dem
        ersten Bildschirm; wer weiterliest, weiß, worauf der Text hinausläuft.
        Bis Oktober 2026 stand die Box hinter dem Fließtext und wurde von den
        meisten nie erreicht. */}
    {zusammenfassung && zusammenfassung.length > 0 && (
      <section class="zusammenfassung" aria-labelledby="zusammenfassung-heading">
        <h2 id="zusammenfassung-heading">Das Wichtigste in Kürze</h2>
        <ul>
          {zusammenfassung.map((punkt) => (
            <li>{punkt}</li>
          ))}
        </ul>
      </section>
    )}

    {inhaltsangabe.length > 1 && (
      <nav class="toc" aria-labelledby="toc-heading">
        <details class="toc-details" open>
        <summary id="toc-heading" class="toc-title">
          Inhalt <span class="toc-anzahl">· {inhaltsangabe.length} Abschnitte</span>
        </summary>
        <ol class="toc-list">
          {inhaltsangabe.map((h) => (
            <li class={h.li ? "toc-li3" : ""}>
              <a href={`#${h.slug}`} data-toc-ziel={h.slug}>{h.text}</a>
            </li>
          ))}
        </ol>
        </details>
      </nav>
    )}

    <div class="article-body">
      <slot />
    </div>

    {/* Nächste Schritte als echte Reihenfolge (<ol>), Ziffern typografisch
        statt in Kreisen (Design-Regel 9). Keine eigene CTA in der Box: Die
        Rechner-Abschlussbox folgt nach den FAQ, eine zweite wäre Dopplung. */}
    {vorgehen && vorgehen.length > 0 && (
      <section class="vorgehen" aria-labelledby="vorgehen-heading">
        <h2 id="vorgehen-heading">So gehen Sie vor</h2>
        <ol>
          {vorgehen.map((schritt) => (
            <li>{schritt}</li>
          ))}
        </ol>
      </section>
    )}

    {faq && <ArticleFaq faq={faq} />}

    <RechnerCta variant="final" href={`/rechner/${relatedRechner}/`} text={abschlussText} />

    <VerwandteArtikel aktuellerSlug={slug} kategorie={category} relatedRechner={relatedRechner} />
  </article>

  {/* Markiert in der Inhaltsübersicht den Abschnitt, der gerade gelesen wird.
      Sichtbar vor allem ab 1240px, wo die Übersicht links mitläuft. Ohne
      JavaScript bleibt sie eine normale Sprungliste. */}
  <script>
    import { starteHeroPunkte } from "../lib/heroPunkte.js";
    const kopf = document.querySelector<HTMLElement>(".artikel-kopf");
    const leinwand = document.querySelector<HTMLCanvasElement>(".artikel-punkte");
    const h1 = kopf?.querySelector("h1");
    if (kopf && leinwand && h1) {
      starteHeroPunkte(kopf, leinwand, {
        // Raster rastet auf der linken Textkante ein, gemessen statt gerechnet.
        kante: () => h1.getBoundingClientRect().left - kopf.getBoundingClientRect().left,
        linien: true,
        staerke: 0.75,
      });
    }
  </script>

  <script>
    // Unter 1240px ist die Übersicht ein aufklappbarer Block über dem Text —
    // zugeklappt, damit sieben Zeilen Navigation nicht den ersten Bildschirm
    // füllen. Ohne JavaScript bleibt sie offen (Attribut steht im HTML).
    const tocDetails = document.querySelector<HTMLDetailsElement>(".toc-details");
    if (tocDetails && !window.matchMedia("(min-width: 1240px)").matches) {
      tocDetails.open = false;
    }

    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-ziel]")].map((a) => [a.dataset.tocZiel, a])
    );
    const ueberschriften = [...links.keys()]
      .map((id) => document.getElementById(id ?? ""))
      .filter((el): el is HTMLElement => el !== null);
    if (ueberschriften.length > 1 && "IntersectionObserver" in window) {
      let aktiv: HTMLAnchorElement | undefined;
      const setzen = (id: string) => {
        const link = links.get(id);
        if (!link || link === aktiv) return;
        aktiv?.removeAttribute("aria-current");
        link.setAttribute("aria-current", "location");
        aktiv = link;
      };
      const beobachter = new IntersectionObserver(
        (eintraege) => {
          for (const e of eintraege) if (e.isIntersecting) setzen(e.target.id);
        },
        { rootMargin: "0px 0px -70% 0px" }
      );
      ueberschriften.forEach((h) => beobachter.observe(h));
    }
  </script>
</BaseLayout>

<style>
  /* Eine linke Kante (CLAUDE.md): Der Artikel beginnt an derselben Kante
     wie Logo, Brotkrume und jede andere Seite — nicht mehr in einer
     zentrierten Spalte, die 260px rechts davon stand. Muster: cleanthinking.de,
     Textspalte links im Satzspiegel, rechts Luft bzw. ab 1240px die
     mitlaufende Inhaltsübersicht. `.prose` bleibt für die Typo-Regeln; Breite
     und Lage setzt diese Regel. */
  .article {
    --spalte: 660px;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding-top: 0;
    padding-bottom: 72px;
  }

  /* Kopfband über die volle Fensterbreite, der Inhalt bleibt in der Spalte:
     negativer Außen- und gleich großer Innenabstand heben sich auf. Der
     Überstand der Scrollbar wird am <body> abgeschnitten (global.css). */
  .article > .artikel-kopf {
    position: relative;
    max-width: none;
    margin-inline: calc(50% - 50vw);
    padding: 28px calc(50vw - 50%) 30px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .artikel-kopf > :global(*:not(canvas)) {
    position: relative;
    max-width: var(--spalte);
  }

  .artikel-punkte {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .artikel-kopf .meta {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }

  .article > :global(*) {
    max-width: var(--spalte);
  }

  h1 {
    font-size: clamp(1.75rem, 1.35rem + 1.9vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.028em;
    margin: 4px 0 20px;
  }

  /* Vorspann in der Lese-Schrift: Er ist der erste Satz des Artikels, nicht
     noch eine Oberflächen-Zeile. */
  .lede {
    font-family: var(--font-lesen);
    font-size: clamp(1.1875rem, 1.1rem + 0.35vw, 1.3125rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 20px;
  }

  .meta {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0 0 32px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
  }

  .meta-sep {
    margin: 0 4px;
  }

  /* Inhaltsangabe — kompakte Anker-Navigation nach dem Muster von
     zolar ("Das erwartet dich") und LichtBlick (Inhaltsangabe). Nur wenn der
     Artikel mehr als eine Überschrift hat, sonst wäre sie Zierde. */
  /* Keine Karte mehr: Die Übersicht ist Navigation, kein Inhaltsblock.
     Eine Linie links trägt die Liste — dieselbe Form wie ab 1240px in der
     mitlaufenden Seitenspalte. */
  .toc {
    margin: 0 0 40px;
  }

  .toc-details {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .toc-title {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
  }

  .toc-title::-webkit-details-marker {
    display: none;
  }

  /* Pfeil als gedrehte Rahmenecke statt Zeichen — dreht sich beim Öffnen. */
  .toc-title::after {
    content: "";
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-right: 1.9px solid currentColor;
    border-bottom: 1.9px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s;
  }

  .toc-details[open] .toc-title::after {
    transform: rotate(-135deg) translateY(-2px);
  }

  .toc-anzahl {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
  }

  .toc-details[open] .toc-list {
    margin-bottom: 14px;
  }

  .toc-list {
    border-left: 1px solid var(--color-border);
  }

  .toc-list a {
    display: block;
    padding: 4px 0 4px 14px;
  }

  .toc-title {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-text-muted);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .toc-list a {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: none;
  }

  .toc-list a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .toc-li3 {
    padding-left: 16px;
    font-size: 13.5px;
  }

  .toc-li3 a {
    color: var(--color-text-secondary);
  }

  .toc-list a[aria-current="location"] {
    color: var(--color-accent-text);
  }

  /* Ab 1240px läuft die Inhaltsübersicht rechts neben dem Text mit (Muster:
     Carbon Brief "Article Contents", Lage wie cleanthinking.de). Textspalte an
     der linken Satzkante, Übersicht bündig mit der rechten Kante der
     Kopfzeile. Nie mit CTA: Die Rechner-Hinweise bleiben im Text (siehe
     CLAUDE.md, "inline, nicht Sidebar"). */
  @media (min-width: 1240px) {
    .article {
      display: grid;
      grid-template-columns: minmax(0, var(--spalte)) minmax(48px, 1fr) 240px;
    }

    .article > :global(*) {
      grid-column: 1;
    }

    .article > .artikel-kopf {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .article > .toc {
      grid-column: 3;
      grid-row: 2 / span 40;
      align-self: start;
      position: sticky;
      top: 32px;
      margin: 0;
      padding: 6px 0 0;
      border: 0;
      background: none;
      max-height: calc(100vh - 56px);
      overflow-y: auto;
    }

    .article > .toc .toc-details {
      border: 0;
    }

    .article > .toc .toc-title {
      cursor: default;
      pointer-events: none;
      padding: 0 0 10px;
    }

    .article > .toc .toc-title::after,
    .article > .toc .toc-anzahl {
      display: none;
    }

    .article > .toc .toc-list {
      gap: 2px;
      border-left: 1px solid var(--color-border);
    }

    .article > .toc .toc-list a {
      display: block;
      padding: 5px 0 5px 14px;
      margin-left: -1px;
      border-left: 2px solid transparent;
      font-size: 13.5px;
      line-height: 1.4;
      color: var(--color-text-secondary);
    }

    .article > .toc .toc-list a:hover {
      color: var(--color-text-primary);
      text-decoration: none;
    }

    .article > .toc .toc-list a[aria-current="location"] {
      color: var(--color-text-primary);
      border-left-color: var(--color-accent);
    }

    .article > .toc .toc-li3 {
      padding-left: 12px;
    }
  }

  .lesefortschritt {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .lesefortschritt {
      display: block;
      position: fixed;
      inset: 0 0 auto 0;
      height: 3px;
      z-index: 60;
      background: var(--color-accent);
      transform-origin: left center;
      transform: scaleX(0);
      animation: fortschritt linear both;
      animation-timeline: scroll(root);
    }

    @media (prefers-reduced-motion: reduce) {
      .lesefortschritt {
        display: none;
      }
    }
  }

  @keyframes fortschritt {
    to {
      transform: scaleX(1);
    }
  }

  /* "Das Wichtigste in Kürze" über dem Text. Autoren-Kernsätze, die im
     Frontmatter gepflegt werden — kein automatisches Extrahieren, das würde
     mutmaßen statt zusammenfassen.
     Gestaltet wie ein Messprotokoll, nicht als weiße Karte mit Punkten (die
     sah generisch aus und stand direkt über einer zweiten Karte, der
     Inhaltsübersicht): kräftige Linie oben, Zeilen mit Haarlinien
     dazwischen. Bewusst ohne 01/02/03 — die Punkte sind keine Reihenfolge. */
  .zusammenfassung {
    margin: 0 0 40px;
    border-top: 2px solid var(--color-text-primary);
  }

  .zusammenfassung h2,
  .vorgehen h2 {
    margin-top: 0;
  }

  .zusammenfassung h2 {
    margin: 0;
    padding: 12px 0 10px;
    font-size: 17px;
    letter-spacing: 0;
  }

  .zusammenfassung ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zusammenfassung li {
    padding: 12px 0;
    border-top: 1px solid var(--color-border);
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-primary);
  }



  /* Die Abschlussblöcke (Vorgehen, FAQ, Weiterlesen) teilen Abstand und
     Überschriftgröße — vorher 20px/24px/24px bei 40px Abstand, sodass sie
     ineinanderliefen. */
  .vorgehen {
    margin-top: 64px;
    padding-top: 22px;
    border-top: 2px solid var(--color-text-primary);
  }

  .vorgehen h2 {
    font-size: 24px;
    margin-bottom: 18px;
  }

  .vorgehen ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: schritt;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vorgehen li {
    counter-increment: schritt;
    display: grid;
    grid-template-columns: 28px 1fr;
    font-size: 16px;
    line-height: 1.55;
  }

  .vorgehen li::before {
    content: counter(schritt);
    font-family: var(--font-display);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent-text);
  }
</style>
