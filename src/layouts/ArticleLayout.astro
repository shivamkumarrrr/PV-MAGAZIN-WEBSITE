---
import BaseLayout from "./BaseLayout.astro";
import RechnerCta from "../components/RechnerCta.astro";
import { categoryLabel } from "../lib/categories.js";

interface Props {
  title: string;
  description: string;
  category: string;
  datePublished: Date;
  dateModified: Date;
  relatedRechner: string;
}

const { title, description, category, datePublished, dateModified, relatedRechner } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const catLabel = categoryLabel(category);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: datePublished.toISOString(),
  dateModified: dateModified.toISOString(),
  publisher: { "@type": "Organization", name: "PPC GmbH" },
  mainEntityOfPage: canonicalURL.toString(),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ratgeber", item: new URL("/ratgeber/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: catLabel, item: new URL(`/ratgeber/${category}/`, Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: title, item: canonicalURL.toString() },
  ],
};
---

<BaseLayout title={`${title} | PPC GmbH`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <article class="prose article">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/ratgeber/">Ratgeber</a> / <a href={`/ratgeber/${category}/`}>{catLabel}</a>
    </nav>

    <p class="eyebrow">{catLabel}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>

    <div class="article-body">
      <slot />
    </div>

    <RechnerCta variant="final" href={`/rechner/${relatedRechner}/`} />
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .breadcrumb {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-hover);
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-accent);
    margin: 0 0 8px;
  }

  h1 {
    font-size: 34px;
    margin-bottom: 12px;
  }

  .lede {
    font-size: 18px;
    color: var(--color-text-secondary);
    margin-bottom: 32px;
  }
</style>
