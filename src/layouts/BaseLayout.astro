---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Standard-Vorschaubild für Social Shares. Vorher wurde `ogImage` zwar als
// Prop akzeptiert, aber von KEINER Seite übergeben — jeder geteilte Link
// erschien ohne Vorschau.
//
// TODO vor Livegang: /og-default.png (1200×630 px) in public/ ablegen und
// OG_STANDARD_VORHANDEN auf true setzen. Solange die Datei fehlt, wird
// bewusst KEIN og:image ausgegeben — ein 404-Bild ist schlechter als gar
// keines, weil Facebook/LinkedIn den kaputten Link cachen.
const OG_STANDARD = "/og-default.png";
const OG_STANDARD_VORHANDEN = false;
const ogBild = ogImage ?? (OG_STANDARD_VORHANDEN ? OG_STANDARD : null);

// Space Grotesk wird selbst gehostet (siehe @font-face in src/styles/global.css)
// — kein Request an fonts.googleapis.com/fonts.gstatic.com mehr, damit keine
// Besucher-IP ohne Einwilligung an Google in die USA geht. Unten nur noch ein
// <link rel="preload"> auf die lokale Datei. Dieser Hinweis steht bewusst im
// Frontmatter statt als HTML-Kommentar: sonst landet er im ausgelieferten
// Markup und taucht bei jeder Suche nach "fonts.googleapis" als Treffer auf.
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Photovoltaik Aktuell" />
    <meta property="og:locale" content="de_DE" />
    {ogBild && <meta property="og:image" content={new URL(ogBild, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
