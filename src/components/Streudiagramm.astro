---
// Streudiagramm als Inline-SVG für den Fließtext — kein Chart-Paket, kein
// JavaScript, kein Drittanbieter-Request (Invariante 1).
//
// Gegenstück zu Diagramm.astro (Balken). Gedacht für Zusammenhänge zwischen
// zwei Größen, z. B. Eigenverbrauchsquote ↔ Jahreswert. Die Daten kommen aus
// src/lib/diagrammDaten.js und damit aus denselben Konstanten wie die Rechner;
// jedes Diagramm trägt deshalb "Modellrechnung" in der Quellenzeile.
//
// Farben wie überall: Akzent für die EINE hervorgehobene Reihe, Sky für die
// Vergleichsreihe, Navy für eine dritte. Jeder Punkt hat ein <title> (Tooltip
// und Screenreader). `paare` verbindet den i-ten Punkt zweier Reihen mit einer
// senkrechten Linie (Hantel-Darstellung: gleicher Haushalt, zwei Regeln).
// `verbinden` zieht eine Linie durch die Punkte einer Reihe.
//
// Bewegung: Die Punkte erscheinen beim Hereinscrollen von links nach rechts
// (clip-path über eine scroll-driven animation). Ohne Unterstützung oder mit
// "Bewegung reduzieren" ist alles sofort sichtbar.
interface Punkt {
  x: number;
  y: number;
  titel?: string;
}
interface Reihe {
  name: string;
  farbe: "akzent" | "sky" | "navy";
  punkte: Punkt[];
  verbinden?: boolean;
  hohl?: boolean;
}
interface Achse {
  titel: string;
  min: number;
  max: number;
  schritte: number[];
  /** Anhang an die Tick-Beschriftung, z. B. " %" oder " €". */
  einheit?: string;
  /** Tausenderpunkte (de-DE) für Tick-Werte. */
  tausender?: boolean;
}
interface Props {
  titel: string;
  untertitel?: string;
  x: Achse;
  y: Achse;
  reihen: Reihe[];
  /** Indizes zweier Reihen, deren gleichnamige Punkte verbunden werden. */
  paare?: [number, number];
  quelle: string;
}

const { titel, untertitel, x, y, reihen, paare, quelle } = Astro.props;

// Zeichenfläche
const B = 640;
const H = 380;
const rand = { links: 84, rechts: 20, oben: 16, unten: 64 };
const breite = B - rand.links - rand.rechts;
const hoehe = H - rand.oben - rand.unten;

const px = (v: number) => rand.links + ((v - x.min) / (x.max - x.min)) * breite;
const py = (v: number) => rand.oben + hoehe - ((v - y.min) / (y.max - y.min)) * hoehe;
const fmt = (v: number, a: Achse) =>
  (a.tausender ? Math.round(v).toLocaleString("de-DE") : v.toLocaleString("de-DE")) + (a.einheit ?? "");

const FARBE = {
  akzent: "var(--color-accent)",
  sky: "var(--color-sky)",
  navy: "var(--color-brand-navy)",
};

const pfad = (punkte: Punkt[]) =>
  [...punkte]
    .sort((a, b) => a.x - b.x)
    .map((p, i) => `${i ? "L" : "M"}${px(p.x).toFixed(1)} ${py(p.y).toFixed(1)}`)
    .join(" ");

const paarLinien =
  paare && reihen[paare[0]] && reihen[paare[1]]
    ? reihen[paare[0]].punkte.map((p, i) => {
        const q = reihen[paare[1]].punkte[i];
        return q ? { x: px(p.x), y1: py(p.y), y2: py(q.y) } : null;
      }).filter(Boolean)
    : [];
---

<figure class="streu">
  <figcaption class="streu-kopf">
    <span class="streu-titel">{titel}</span>
    {untertitel && <span class="streu-untertitel">{untertitel}</span>}
  </figcaption>

  <ul class="streu-legende">
    {reihen.map((r) => (
      <li>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <circle
            cx="6" cy="6" r="4.5"
            fill={r.hohl ? "var(--color-surface)" : FARBE[r.farbe]}
            stroke={FARBE[r.farbe]}
            stroke-width={r.hohl ? 2 : 0}
          />
        </svg>
        {r.name}
      </li>
    ))}
  </ul>

  <svg class="streu-svg" viewBox={`0 0 ${B} ${H}`} role="img" aria-label={`${titel}. ${untertitel ?? ""}`}>
    {/* Raster */}
    <g class="streu-raster" aria-hidden="true">
      {y.schritte.map((v) => (
        <>
          <line x1={rand.links} x2={B - rand.rechts} y1={py(v)} y2={py(v)} />
          <text x={rand.links - 10} y={py(v) + 4} text-anchor="end">{fmt(v, y)}</text>
        </>
      ))}
      {x.schritte.map((v, i) => (
        <text class:list={["streu-xtick", { "streu-tick-ungerade": i % 2 === 1 }]} x={px(v)} y={H - rand.unten + 22} text-anchor="middle">{fmt(v, x)}</text>
      ))}
      <line class="streu-achse" x1={rand.links} x2={B - rand.rechts} y1={rand.oben + hoehe} y2={rand.oben + hoehe} />
    </g>

    <text class="streu-achsentitel" x={rand.links + breite / 2} y={H - 4} text-anchor="middle">{x.titel}</text>
    <text
      class="streu-achsentitel streu-ytitel"
      x={12}
      y={rand.oben + hoehe / 2}
      text-anchor="middle"
      transform={`rotate(-90 12 ${rand.oben + hoehe / 2})`}
    >{y.titel}</text>

    <g class="streu-daten">
      {paarLinien.map((l) => (
        <line class="streu-paar" x1={l.x} x2={l.x} y1={l.y1} y2={l.y2} />
      ))}

      {reihen.map((r) =>
        r.verbinden ? (
          <path d={pfad(r.punkte)} fill="none" stroke={FARBE[r.farbe]} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" opacity="0.55" />
        ) : null
      )}

      {reihen.map((r) =>
        r.punkte.map((p) => (
          <circle
            class="streu-punkt"
            cx={px(p.x).toFixed(1)}
            cy={py(p.y).toFixed(1)}
            r="5"
            fill={r.hohl ? "var(--color-surface)" : FARBE[r.farbe]}
            stroke={r.hohl ? FARBE[r.farbe] : "var(--color-surface)"}
            stroke-width={r.hohl ? 2 : 1.5}
          >
            {p.titel && <title>{p.titel}</title>}
          </circle>
        ))
      )}
    </g>
  </svg>

  <p class="streu-quelle">Quelle: {quelle}</p>
</figure>

<style>
  .streu {
    margin: 2.2em 0;
    padding: 20px 22px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-family: var(--font-display);
  }

  .streu-kopf {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 12px;
  }

  .streu-titel {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .streu-untertitel {
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .streu-legende {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0 0 6px !important;
    padding: 0 !important;
    list-style: none;
  }

  .streu-legende li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: 12.5px !important;
    color: var(--color-text-secondary) !important;
  }

  .streu-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .streu-raster line {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .streu-raster .streu-achse {
    stroke: var(--color-text-muted);
  }

  .streu-raster text {
    font-size: 12px;
    fill: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .streu-achsentitel {
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--color-text-secondary);
  }

  .streu-paar {
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
    opacity: 0.45;
  }

  .streu-punkt {
    transition: r 0.15s;
  }

  .streu-punkt:hover {
    r: 7;
  }

  .streu-quelle {
    margin: 12px 0 0 !important;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
    font-size: 11px !important;
    line-height: 1.5;
    color: var(--color-text-muted) !important;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .streu-daten {
        animation: streu-aufdecken linear both;
        animation-timeline: view();
        animation-range: entry 25% cover 45%;
      }
    }
  }

  @keyframes streu-aufdecken {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Auf dem Handy schrumpft die 640er-Zeichenfläche auf knapp die Hälfte.
     Schrift und Punkte deshalb in Zeichenflächen-Einheiten vergrößern, damit
     sie real bei ~11px bzw. ~4px Radius landen; jede zweite x-Marke entfällt,
     sonst laufen die Beschriftungen ineinander. */
  @media (max-width: 480px) {
    .streu {
      padding: 16px 14px 12px;
    }

    .streu-raster text,
    .streu-achsentitel {
      font-size: 23px;
    }

    .streu-tick-ungerade,
    .streu-ytitel {
      display: none;
    }

    .streu-xtick {
      transform: translateY(10px);
    }

    .streu-punkt {
      r: 8;
    }

    .streu-punkt:hover {
      r: 10;
    }
  }
</style>
