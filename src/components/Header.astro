---
import logo from "../assets/pv-aktuell-logo-light.png";
import { Image } from "astro:assets";

const { pathname } = Astro.url;
const isRatgeber = pathname.startsWith("/ratgeber");
const isRechner = pathname.startsWith("/rechner");
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Startseite">
      <Image src={logo} alt="Photovoltaik Aktuell" height={32} loading="eager" />
    </a>
    <nav class="main-nav" aria-label="Hauptnavigation">
      <a href="/ratgeber/" class:list={["nav-link", { active: isRatgeber }]}>Ratgeber</a>
      <a href="/rechner/" class:list={["nav-link", { active: isRechner }]}>Rechner</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
  }

  .main-nav {
    display: flex;
    gap: 8px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .nav-link:hover {
    background: var(--color-accent-subtle);
    color: var(--color-accent-hover);
  }

  .nav-link.active {
    background: var(--color-text-primary);
    color: #fff;
  }
</style>
