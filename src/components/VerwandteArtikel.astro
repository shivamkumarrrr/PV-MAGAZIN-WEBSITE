---
import { getCollection } from "astro:content";
import ArtikelKarte from "./ArtikelKarte.astro";

// Automatische Querverlinkung am Artikelende.
//
// Vorher enthielt KEIN einziger der 17 Artikel einen Link auf einen anderen
// Artikel — kein Themencluster, kein Linkfluss, jede Seite eine Sackgasse.
// Diese Auswahl wird abgeleitet statt gepflegt, damit sie beim Hinzufügen
// eines Artikels nicht veraltet:
//   1. gleicher relatedRechner (stärkstes Signal: gleiches Werkzeug = gleiches Thema)
//   2. gleiche Kategorie
//   3. auffüllen mit den neuesten übrigen Artikeln
interface Props {
  aktuellerSlug: string;
  kategorie: string;
  relatedRechner: string;
  anzahl?: number;
}
// Vier statt drei Vorschläge: Die Karten stehen in einem Zweierraster, und
// drei ließen unten eine einzelne Karte allein stehen. Der vierte Link ist
// zudem ein Link mehr im Themencluster — bis September 2026 hatte kein
// Artikel überhaupt einen ausgehenden Link (siehe CLAUDE.md).
const { aktuellerSlug, kategorie, relatedRechner, anzahl = 4 } = Astro.props;

const alle = (await getCollection("articles"))
  .filter((a) => a.id !== aktuellerSlug)
  .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf());

const gewichtet = [
  ...alle.filter((a) => a.data.relatedRechner === relatedRechner),
  ...alle.filter((a) => a.data.category === kategorie),
  ...alle,
];

// Reihenfolge der ersten Fundstelle behalten, Duplikate raus.
const vorschlaege = [...new Map(gewichtet.map((a) => [a.id, a])).values()].slice(0, anzahl);
---

{vorschlaege.length > 0 && (
  <nav class="verwandte" aria-labelledby="verwandte-heading">
    <h2 id="verwandte-heading">Weiterlesen</h2>
    <ul class="verwandte-raster">
      {vorschlaege.map((a) => (
        <li>
          <ArtikelKarte artikel={a} mitKategorie />
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .verwandte {
    margin-top: 2.5em;
  }

  .verwandte h2 {
    font-size: 24px;
    margin-bottom: 0.6em;
  }

  /* Dieselbe Karte wie auf /ratgeber/, der Startseite und den
     Kategorieseiten (ArtikelKarte.astro) — vorher waren das hier reine
     Textzeilen ohne Bild, also eine fünfte Darstellungsform für dieselbe
     Sache. Zwei Spalten statt drei: Die Artikelspalte ist 620px breit, drei
     Karten darin wären 190px schmal. */
  .verwandte-raster {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .verwandte-raster li {
    display: flex;
  }

  @media (max-width: 560px) {
    .verwandte-raster {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

</style>
