---
// Balkendiagramm für den Artikel-Fließtext.
//
// Reines HTML/CSS, kein JavaScript und kein Canvas: die Zahlen stehen als
// Text im Markup, sind also indexierbar, vorlesbar und ohne JS sichtbar.
// Farbe folgt dem Design System — Sky (#2E6F95) ist die Datenfarbe,
// Akzent-Orange ist dem hervorgehobenen Balken vorbehalten (Design-Regel 2).
//
// Nutzung im MDX:
//   <Diagramm
//     titel="Systemkosten je kWp"
//     einheit="€ pro kWp"
//     quelle="Fraunhofer ISE, Marktpreisübersicht 2026"
//     werte={[
//       { label: "5 kWp", wert: 1300 },
//       { label: "10 kWp", wert: 1150, hervor: true },
//     ]}
//   />
interface Wert {
  label: string;
  wert: number;
  /** Anzeigetext, falls die Zahl anders formatiert werden soll als der Wert. */
  anzeige?: string;
  /** Hebt genau einen Balken in Akzentfarbe hervor. */
  hervor?: boolean;
}

interface Props {
  titel: string;
  einheit?: string;
  quelle: string;
  werte: Wert[];
  /** Obergrenze der Skala; sonst der größte Wert. */
  max?: number;
}

const { titel, einheit, quelle, werte, max } = Astro.props;

const obergrenze = max ?? Math.max(...werte.map((w) => w.wert));
const zahlFormat = new Intl.NumberFormat("de-DE", { maximumFractionDigits: 2 });
---

<figure class="diagramm">
  <figcaption class="diagramm-kopf">
    <span class="diagramm-titel">{titel}</span>
    {einheit && <span class="diagramm-einheit">{einheit}</span>}
  </figcaption>

  <ul class="diagramm-liste">
    {werte.map((w) => (
      <li class="diagramm-zeile">
        <span class="diagramm-label">{w.label}</span>
        <span class="diagramm-spur">
          <span
            class:list={["diagramm-balken", { "diagramm-balken--hervor": w.hervor }]}
            style={`width: ${obergrenze > 0 ? Math.max((w.wert / obergrenze) * 100, 1.5) : 0}%`}
          />
        </span>
        <span class="diagramm-wert">{w.anzeige ?? zahlFormat.format(w.wert)}</span>
      </li>
    ))}
  </ul>

  <p class="diagramm-quelle">{quelle}</p>
</figure>

<style>
  .diagramm {
    margin: 2.2em 0;
    padding: 20px 22px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-family: var(--font-display);
  }

  .diagramm-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-bottom: 16px;
  }

  .diagramm-titel {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .diagramm-einheit {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .diagramm-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .diagramm-zeile {
    display: grid;
    grid-template-columns: minmax(96px, 30%) 1fr auto;
    align-items: center;
    gap: 10px;
  }

  .diagramm-label {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.35;
  }

  .diagramm-spur {
    display: block;
    height: 12px;
    border-radius: var(--radius-pill);
    background: var(--color-sky-subtle);
    overflow: hidden;
  }

  .diagramm-balken {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--color-sky);
  }

  .diagramm-balken--hervor {
    background: var(--color-accent);
  }

  .diagramm-wert {
    font-size: 13.5px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .diagramm-quelle {
    margin: 16px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .diagramm-zeile {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "label wert"
        "spur spur";
      gap: 4px 10px;
    }

    .diagramm-label { grid-area: label; }
    .diagramm-wert { grid-area: wert; }
    .diagramm-spur { grid-area: spur; }
  }
</style>
