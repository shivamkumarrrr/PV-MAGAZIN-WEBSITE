---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { categoryLabel } from "../lib/categories.js";
import { RECHNER } from "../lib/rechner.js";
import RechnerWidget from "../components/RechnerWidget.jsx";
import { STROMPREIS, EINSPEISE } from "../lib/calculate.js";
import {
  IconRechnerPhotovoltaik,
  IconRechnerKombi,
  IconRechnerRendite,
  IconRechnerSpeicher,
  IconRechnerBalkonkraftwerk,
  IconRechnerCo2,
  IconRechnerGestehungskosten,
  IconRechnerReinigung,
  IconRechnerEauto,
  IconRechnerSteuer,
  IconRechnerMieterstrom,
} from "../components/IconsRechner.jsx";

// Gestaltungsansatz: Die Seite argumentiert durchgehend mit belegten Zahlen —
// also sieht sie aus wie ein Messprotokoll, nicht wie eine Werbeseite. Kein
// Verlaufsbanner, keine Sonnen-Symbole, keine lachende Familie auf dem Dach;
// das sind die Reflexe, die jede zweite Solar-Landingpage bedient.
//
// EIN Signature-Element (CLAUDE.md Design-Regel 11): das Hero-Bild — eine
// ruhige Nahaufnahme einer Modulfläche im Streiflicht. Bewusst kein
// Gebäude mit lesbarem Firmenschild und keine Menschen: beides würde sich
// als Referenzkunde lesen, den es nicht gibt. Vorher stand hier die
// Ertragskurve; die Komponente bleibt im Projekt
// (src/components/Ertragskurve.astro), ist aber nicht mehr eingebunden.
// Alles andere bleibt bewusst ruhig.
//
// Tonale Gliederung (neu): Die Seite lief vorher durchgehend in Off-White
// mit 1-px-Rändern — jeder Abschnitt sah aus wie der davor, nichts trug
// Gewicht. Jetzt drei Ebenen: helle Arbeitsflächen (Hero, Rechner,
// Ratgeber), EINE dunkle Platte in Brand-Navy für die Quellen (das ist das
// inhaltliche Zentrum der Seite und darf wie ein Prüfsiegel wirken) und EIN
// Akzentfeld in PPC-Orange ganz am Schluss für die Handlung. Das Orange
// bleibt damit dem Handeln vorbehalten (Design-Regel 2), taucht aber
// endlich einmal in Flächengröße auf, statt nur als 40-px-Knopf.
//
// Bewusst KEIN Eyebrow-Label über jedem Abschnitt — das wiederholte
// Kleinversalien-Kicker-Muster ist ein bekannter Generierungs-Tell. Die
// Überschriften tragen sich selbst.
const artikel = (await getCollection("articles")).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);
const neueste = artikel.slice(0, 4);

// Der Photovoltaik-Rechner steht auf dieser Seite nicht mehr als Karte: Er
// ist oben als Mini-Rechner bereits benutzbar, eine zweite Karte mit
// demselben Ziel wäre dieselbe Einladung zum zweiten Mal.
const weitereRechner = RECHNER.filter((r) => r.slug !== "photovoltaik");

// Zeichen je Rechner — dieselbe Zuordnung wie auf /rechner/. Ohne
// client:-Direktive rendert Astro sie zu statischem SVG, die Seite lädt
// dafür kein JavaScript. Die elf Signets liegen längst im Projekt.
const SIGNET = {
  photovoltaik: IconRechnerPhotovoltaik,
  kombi: IconRechnerKombi,
  rendite: IconRechnerRendite,
  speicher: IconRechnerSpeicher,
  balkonkraftwerk: IconRechnerBalkonkraftwerk,
  co2: IconRechnerCo2,
  gestehungskosten: IconRechnerGestehungskosten,
  reinigung: IconRechnerReinigung,
  eauto: IconRechnerEauto,
  steuer: IconRechnerSteuer,
  mieterstrom: IconRechnerMieterstrom,
};

const nf = new Intl.NumberFormat("de-DE");
const ct = (eur) =>
  new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2 }).format(eur * 100);

// Die Quellen sind das eigentliche Unterscheidungsmerkmal gegenüber ADAC,
// co2online und den Anbieter-Rechnern — deshalb ein eigener Abschnitt statt
// einer Fußnote. Jede Zeile nennt, was diese Quelle konkret liefert; eine
// reine Logo-Reihe wäre eine Behauptung, das hier ist überprüfbar.
const quellen = [
  { name: "PVGIS", traeger: "EU Joint Research Centre", liefert: "Sonneneinstrahlung und Monatserträge für die exakten Koordinaten Ihrer Adresse" },
  { name: "BDEW", traeger: "Bundesverband der Energie- und Wasserwirtschaft", liefert: "Haushaltsstrompreis und saisonales Lastprofil" },
  { name: "Bundesnetzagentur", traeger: "§ 49 EEG", liefert: "Einspeisevergütung samt Staffelung über 10 kWp und Mieterstromzuschlag" },
  { name: "Fraunhofer ISE", traeger: "Institut für Solare Energiesysteme", liefert: "Systemkosten je kWp, Volllaststunden und Stromgestehungskosten" },
  { name: "HTW Berlin", traeger: "Stromspeicher-Inspektion", liefert: "Speicher-Dimensionierung und gemessene Systemwirkungsgrade" },
  { name: "ADAC", traeger: "Ratgeber Photovoltaik", liefert: "Autarkiegrade, Haushaltsverbrauch und Wechselrichter-Austauschkosten" },
  { name: "Umweltbundesamt", traeger: "Emissionsbilanz Strommix", liefert: "CO₂-Faktor je Kilowattstunde Netzstrom" },
];
---

<BaseLayout
  title="Photovoltaik-Ratgeber & PV-Rechner | Photovoltaik Aktuell"
  description="Unabhängiger Ratgeber zu Photovoltaik-Kosten, Förderung, Speicher und Einspeisevergütung — plus PV-Rechner mit echten PVGIS-Satellitendaten für Ihren Standort."
>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-text">
        <h1>Was Ihr Dach wirklich bringt — nachgerechnet, nicht geschätzt</h1>
        <p class="hero-lead">
          Elf Rechner auf einer gemeinsamen Datenbasis: Satellitendaten für
          Ihre Postleitzahl, Vergütungssätze aus dem Gesetz, Kosten aus der
          Marktstatistik. Selbst verbrauchter Strom spart derzeit {ct(STROMPREIS)} ct
          je Kilowattstunde, eingespeister bringt bei Anlagen bis
          10 kWp {ct(EINSPEISE)} ct — jede Zahl hier mit Quelle und Stand.
        </p>
        <div class="hero-aktionen">
          <a href="/rechner/photovoltaik/" class="knopf-primaer">Ertrag berechnen</a>
          <a href="/ratgeber/" class="knopf-sekundaer">Zum Ratgeber</a>
        </div>
      </div>

      <div class="hero-grafik">
        <figure class="hero-bild">
          <img
            src="/images/startseite.jpg"
            alt="Luftaufnahme eines Wohnhauses mit Solarmodulen auf dem Flachdach, umgeben von Gärten"
            width="1200"
            height="1500"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            sizes="(min-width: 860px) 46vw, 100vw"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Der Mini-Rechner liegt auf der Kante zwischen Hero und Rechner-Band,
       statt als weitere Kachel weiter unten zu warten: Wer auf der Startseite
       landet, hat nach zwei Sekunden eine eigene Zahl vor sich, ohne Klick und
       ohne Standortabfrage. Muster von lichtblick.de (Tarifrechner auf der
       Bandkante) und zolar (Rechner vor dem Erklärtext). `client:load`, weil
       die Karte der aktive Inhalt der Stelle ist und nicht Randdekor. -->
  <div class="hero-rechner">
    <div class="container">
      <div class="hero-rechner-karte">
        <RechnerWidget client:load variante="hero" />
      </div>
    </div>
  </div>

  <section class="rechner container">
    <div class="abschnitt-kopf">
      <h2>Zehn weitere Rechner</h2>
      <p>
        Speicher, Rendite, Steuer, Mieterstrom — jeder mit eigener
        Fragestellung, alle auf derselben Datenbasis wie oben.
      </p>
    </div>

    <ul class="rechner-liste">
      {weitereRechner.map((r) => {
        const Signet = SIGNET[r.slug];
        return (
          <li>
            <a href={`/rechner/${r.slug}/`}>
              {Signet && <span class="rechner-signet" aria-hidden="true"><Signet size={22} /></span>}
              <span class="rechner-name">{r.kurz}</span>
              <span class="rechner-zweck">{r.beschreibung}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="quellen">
    <div class="container">
      <div class="abschnitt-kopf quellen-kopf">
        <h2>Woher die Zahlen kommen</h2>
        <p>
          Keine Anbieter-Schätzungen. Jede Konstante in unseren Rechnern ist im
          Quellcode mit Quelle, Stand und Prüf-Rhythmus hinterlegt.
        </p>
      </div>

      <dl class="quellen-liste">
        {quellen.map((q) => (
          <div class="quelle">
            <dt>
              {q.name}
              <span class="quelle-traeger">{q.traeger}</span>
            </dt>
            <dd>{q.liefert}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="ratgeber">
    <div class="container">
    <div class="abschnitt-kopf">
      <h2>Neu im Ratgeber</h2>
      <p>Von den Grundlagen bis zur Checkliste vor dem Kauf.</p>
    </div>

    <ul class="artikel-liste">
      {neueste.map((a) => (
        <li>
          <a href={`/ratgeber/${a.id}/`}>
            <span class="artikel-kategorie">{categoryLabel(a.data.category)}</span>
            <span class="artikel-titel">{a.data.title}</span>
            <span class="artikel-beschreibung">{a.data.description}</span>
          </a>
        </li>
      ))}
    </ul>

    <a href="/ratgeber/" class="alle-artikel">
      Alle {nf.format(artikel.length)} Artikel ansehen →
    </a>
    </div>
  </section>

  <!-- Abschluss: das einzige Akzentfeld der Seite. Text in Tintenschwarz
       statt Weiß — Weiß auf #FF5200 erreicht nur 3,3:1 und wäre auf
       Fließtextgröße nicht lesbar; Tintenschwarz liegt bei ~7:1. -->
  <section class="abschluss">
    <div class="container abschluss-inner">
      <div>
        <h2>Rechnen Sie Ihr Dach durch</h2>
        <p>
          Vier Schritte, keine Anmeldung. Sie geben Dachfläche, Ausrichtung und
          Stromverbrauch ein, PVGIS liefert die Einstrahlung für Ihre
          Postleitzahl, am Ende steht die Amortisation in Jahren.
        </p>
      </div>
      <a href="/rechner/photovoltaik/" class="knopf-dunkel">Ertrag berechnen →</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Der Footer setzt global 64 px Abstand nach oben — sinnvoll hinter einem
     Artikel, aber hier läge ein Streifen Seitenhintergrund zwischen dem
     Akzentfeld und dem Footer. Nur auf dieser Seite abgeschaltet. */
  .site-footer {
    margin-top: 0;
  }
</style>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */

  .hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    display: grid;
    gap: clamp(24px, 5vw, 64px);
    padding-top: clamp(36px, 8vw, 92px);
    padding-bottom: clamp(32px, 6vw, 72px);
    align-items: center;
  }

  /* Asymmetrisch: der Text trägt mehr Gewicht als die Grafik, statt beide
     Spalten gleich breit zu setzen. */
  @media (min-width: 860px) {
    .hero-inner {
      grid-template-columns: 1.02fr 0.98fr;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5.4vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 20px;
    max-width: 17ch;
  }

  .hero-lead {
    margin: 0 0 30px;
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.0625rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Ein Auftritt beim Laden, gestaffelt — nicht drei verstreute Effekte.
     Ruhezustand ist der fertige Zustand: die Elemente sind ohne CSS-
     Animation sichtbar, die Animation blendet sie nur ein. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1,
    .hero-lead,
    .hero-aktionen {
      animation: auftritt 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-lead { animation-delay: 0.08s; }
    .hero-aktionen { animation-delay: 0.16s; }
  }

  @keyframes auftritt {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  .hero-aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Das Bild sitzt randlos in derselben 1-px-Fläche wie die Cards der
     Seite — kein Schatten, kein Verlauf darüber (Design-Regeln 4 und 7).
     Es füllt die Höhe der Textspalte: eine kleinere, mittig schwebende
     Kachel ließ rechts neben der Überschrift eine tote Fläche stehen.
     Am Handy liegt es über dem Text und wird flacher beschnitten, damit
     es nicht den halben ersten Bildschirm einnimmt. */
  .hero-bild {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    aspect-ratio: 4 / 3;
  }

  .hero-bild img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Hochformatige Datei: am Handy den Bildausschnitt auf das Haus
       ziehen, sonst füllt der Garten den flacheren Rahmen. */
    object-position: 50% 46%;
  }

  @media (min-width: 860px) {
    .hero-bild img {
      object-position: 50% 50%;
    }
  }

  @media (min-width: 860px) {
    .hero-bild {
      aspect-ratio: 1200 / 1500;
      max-height: 560px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-bild {
      animation: auftritt 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
    }
  }

  .knopf-primaer,
  .knopf-sekundaer {
    display: inline-flex;
    align-items: center;
    padding: 15px 28px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s,
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .knopf-primaer {
    background: var(--color-accent);
    color: #fff;
    border: 1px solid var(--color-accent);
  }

  .knopf-primaer:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .knopf-sekundaer {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .knopf-sekundaer:hover {
    border-color: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .knopf-primaer:hover { transform: none; }
  }

  /* ── Gemeinsamer Abschnittskopf ─────────────────────────────────────── */

  .abschnitt-kopf {
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .abschnitt-kopf h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    letter-spacing: -0.025em;
    margin: 0 0 10px;
  }

  .abschnitt-kopf p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 16px;
  }

  .rechner,
  .ratgeber {
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  /* ── Mini-Rechner auf der Hero-Kante ────────────────────────────────── */

  /* Die Karte hängt über die Trennlinie des Hero-Bandes, wie der
     Tarifrechner auf lichtblick.de. Am Handy wird nicht gezogen: dort
     steht die Karte einfach unter dem Hero, sonst klebt sie am Bild.
     Die Karte läuft über die volle Inhaltsbreite: ihre rechte Kante liegt
     damit auf derselben Linie wie die Rechner-Karte darunter und wie der
     Abschluss-Block. Vorher endete sie 240 px früher und stand an der
     rechten Seite auf keiner Kante der Seite. */
  .hero-rechner {
    position: relative;
    z-index: 1;
    padding-top: 28px;
  }

  @media (min-width: 860px) {
    .hero-rechner {
      margin-top: clamp(-56px, -4vw, -28px);
      padding-top: 0;
    }
  }

  /* Ein heller Streifen im Wechsel mit dem Seitengrund — beide
     Wettbewerber gliedern lange Seiten so, statt über weitere
     Kartenrahmen (LichtBlick: #FFFFFF und #F0F0F0 im Wechsel, je 64 px
     Luft). Keine neue Farbe, kein Verlauf. */
  .ratgeber {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Rechner ────────────────────────────────────────────────────────── */

  .rechner-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* Genau zwei Spalten: die zehn Nebenrechner gehen restlos auf. Mit
     auto-fit blieben bei vier Spalten zwei leere Zellen übrig, in denen
     der Rand-Hintergrund als grauer Block sichtbar wurde. */
  @media (min-width: 640px) {
    .rechner-liste {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Signet in eigener Spalte: es soll den Namen ankündigen, nicht über ihm
     schweben wie das Icon-über-jeder-Überschrift-Muster. */
  .rechner-liste a {
    display: grid;
    grid-template-columns: 22px 1fr;
    column-gap: 14px;
    height: 100%;
    padding: 18px 20px;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s;
  }

  .rechner-signet {
    grid-row: span 2;
    display: block;
    padding-top: 2px;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  .rechner-liste a:hover {
    background: var(--color-accent-subtle);
  }

  .rechner-liste a:hover .rechner-signet {
    color: var(--color-accent);
  }

  .rechner-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 5px;
  }

  .rechner-zweck {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* ── Quellen ────────────────────────────────────────────────────────── */

  /* Die einzige dunkle Platte der Seite. Sie trägt das Argument, mit dem
     sich dieses Produkt von ADAC- und Anbieter-Rechnern unterscheidet, und
     gibt der Seite gleichzeitig den tonalen Halt, der ihr in durchgehendem
     Off-White gefehlt hat. Brand-Navy, nicht Schwarz — Schwarz plus
     Neon-Akzent ist ein bekannter Generierungs-Tell (Design-Regel 5). */
  .quellen {
    background: var(--color-brand-navy);
    color: #fff;
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .quellen-kopf h2 {
    color: #fff;
  }

  /* Heller Text auf dunklem Grund wirkt dünner — 0,05 mehr Zeilenhöhe und
     eine kräftigere Sekundärfarbe (ca. 7:1 statt 3,1:1 mit #5A6570). */
  .quellen-kopf p {
    color: #C9CCD6;
    line-height: 1.65;
  }

  /* Typografische Liste statt Logo-Reihe oder Icon-Text-Pillen: Was eine
     Quelle liefert, ist überprüfbar — ein Logo ist nur eine Behauptung. */
  .quellen-liste {
    margin: 0;
    display: grid;
    gap: 0;
  }

  @media (min-width: 720px) {
    .quellen-liste {
      grid-template-columns: 1fr 1fr;
      column-gap: 48px;
    }
  }

  .quelle {
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .quelle dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15.5px;
    color: #fff;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 5px;
  }

  .quelle-traeger {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 12.5px;
    color: #A9AEBC;
  }

  .quelle dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #C9CCD6;
    max-width: 50ch;
  }

  /* ── Ratgeber ───────────────────────────────────────────────────────── */

  /* Zeilen statt Karten — dieselbe Form wie das Register auf /ratgeber/,
     damit beide Listen sich gleich lesen. Vorher standen Kategorie und
     Titel auf einer Zeile mit justify-content: space-between, wodurch die
     Titel auf breiten Bildschirmen an der rechten Kante klebten. */
  .artikel-liste {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }

  .artikel-liste li {
    border-top: 1px solid var(--color-border);
  }

  .artikel-liste li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .artikel-liste a {
    display: grid;
    gap: 4px 24px;
    padding: 20px 12px 22px 0;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.15s;
  }

  /* Kategorie in eine eigene schmale Spalte: sie wird beim Überfliegen
     gesucht, soll dem Titel aber nicht die Zeile wegnehmen. */
  @media (min-width: 760px) {
    .artikel-liste a {
      grid-template-columns: 170px 1fr;
    }

    .artikel-kategorie {
      grid-row: span 2;
      padding-top: 4px;
    }
  }

  .artikel-liste a:hover {
    background: var(--color-surface);
    transform: translateX(10px);
  }

  @media (prefers-reduced-motion: reduce) {
    .artikel-liste a {
      transition: background-color 0.15s;
    }
    .artikel-liste a:hover {
      transform: none;
    }
  }

  .artikel-kategorie {
    font-size: var(--schrift-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .artikel-titel {
    font-family: var(--font-display);
    font-weight: 600;
