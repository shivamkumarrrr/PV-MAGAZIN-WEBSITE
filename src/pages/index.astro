---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroBild from "../assets/hero-modulflaeche.jpg";
// Bild neben "Was ist Photovoltaik?". EINE Stelle zum Austauschen: Datei nach
// src/assets/ legen, hier importieren, Alt-Text unten anpassen, Fotograf und
// Fundstelle in src/assets/heroes/BILDNACHWEIS.md eintragen.
//
// ACHTUNG Auflösung: Die Datei ist 550x367px. Das reicht für die Anzeige-
// breite von rund 500px bei einfacher Pixeldichte, auf Retina-Displays wird
// das Bild sichtbar weich. Die `widths` unten enden deshalb bei 550 — größere
// Werte würde Astro ohnehin nicht hochrechnen. Sobald ein größeres Original
// vorliegt (mindestens 1100px breit), Datei ersetzen und `widths` erhöhen.
import erklaertBild from "../assets/montage-team.jpg";
import ArtikelKarte from "../components/ArtikelKarte.astro";
import { rechnerGruppen } from "../lib/rechner.js";
import Definition from "../components/Definition.astro";
import {
  IconRechnerPhotovoltaik,
  IconRechnerKombi,
  IconRechnerRendite,
  IconRechnerSpeicher,
  IconRechnerBalkonkraftwerk,
  IconRechnerCo2,
  IconRechnerGestehungskosten,
  IconRechnerReinigung,
  IconRechnerEauto,
  IconRechnerSteuer,
  IconRechnerMieterstrom,
} from "../components/IconsRechner.jsx";
import RechnerWidget from "../components/RechnerWidget.jsx";
import { STROMPREIS, EINSPEISE } from "../lib/calculate.js";

// Gestaltungsansatz: Die Seite argumentiert durchgehend mit belegten Zahlen —
// also sieht sie aus wie ein Messprotokoll, nicht wie eine Werbeseite. Kein
// Verlaufsbanner, keine Sonnen-Symbole, keine lachende Familie auf dem Dach;
// das sind die Reflexe, die jede zweite Solar-Landingpage bedient.
//
// EIN Signature-Element (CLAUDE.md Design-Regel 11): das Hero-Bild — eine
// Nahaufnahme einer Modulfläche im Streiflicht. Bewusst kein Gebäude mit
// lesbarem Firmenschild und keine Menschen: beides würde sich als
// Referenzkunde lesen, den es nicht gibt.
//
// Tonale Gliederung: durchgehend helle Arbeitsflächen. Bis September 2026
// trug die Seite an zweiter Position eine dunkle Vollflächen-Platte in
// Brand-Navy mit sieben Quellenangaben. Der Inhalt war richtig, die Stelle
// falsch: Wer gerade eine Zahl gelesen hat, will wissen, was sie für ihn
// bedeutet, nicht ein Literaturverzeichnis. Der Beleg steht jetzt als eine
// Zeile unter dem Mini-Rechner — neben der Zahl, um die es geht —, die
// vollständige Tabelle samt Grenzen des Modells auf /methodik/.
//
// Der Ablauf der Seite folgt einer Frage nach der anderen: Was bringt mein
// Dach? (PLZ-Feld + Mini-Rechner, der seinen Beleg gleich mitbringt) → Was
// soll ich als Nächstes lesen? (Ratgeber) → Und wenn meine Frage eine andere
// war? (weitere Rechner). Vorher endete die Seite mit
// einem vollflächig orangen Band, das denselben Link zum dritten Mal
// anbot — dieselbe Einladung lauter zu wiederholen überzeugt niemanden,
// und ein Vollflächen-Akzent am Seitenende ist ein bekannter
// Generierungs-Tell. Der Einstieg steht jetzt einmal, ganz oben, und
// verlangt eine konkrete Angabe statt eines Klicks.
//
// Bewusst KEIN Eyebrow-Label über einer Überschrift — das
// Kleinversalien-Kicker-Muster ist ein bekannter Generierungs-Tell. Die
// Überschriften tragen sich selbst.
const artikel = (await getCollection("articles")).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);
const neueste = artikel.slice(0, 3);

// Der Photovoltaik-Rechner selbst steht hier nicht mehr in der Liste: Er ist
// oben als Mini-Rechner bereits benutzbar, ein zweiter Eintrag mit demselben
// Ziel wäre dieselbe Einladung zum zweiten Mal. Die Gruppierung kommt aus
// src/lib/rechner.js und ist dieselbe, die das Nav-Panel im Header trägt —
// wer sie einmal gelernt hat, findet sich an beiden Stellen zurecht.
const gruppen = rechnerGruppen();

// Die elf handgezeichneten Signets (Quelle: Figma, siehe CLAUDE.md und
// scripts/signets-sync.mjs) sind das einzige eigens für dieses Projekt
// gezeichnete Bildmaterial — sie gehören an die Rechner-Liste, nicht ins
// Archiv. Ohne client:-Direktive rendert Astro sie zu statischem SVG, die
// Seite lädt dafür kein JavaScript.
const SIGNET = {
  photovoltaik: IconRechnerPhotovoltaik,
  kombi: IconRechnerKombi,
  rendite: IconRechnerRendite,
  speicher: IconRechnerSpeicher,
  balkonkraftwerk: IconRechnerBalkonkraftwerk,
  co2: IconRechnerCo2,
  gestehungskosten: IconRechnerGestehungskosten,
  reinigung: IconRechnerReinigung,
  eauto: IconRechnerEauto,
  steuer: IconRechnerSteuer,
  mieterstrom: IconRechnerMieterstrom,
};

const nf = new Intl.NumberFormat("de-DE");
const ct = (eur) =>
  new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2 }).format(eur * 100);


// "Was ist Photovoltaik?" — Einstiegsblock für Leser, die noch vor der
// Grundsatzfrage stehen (Vorgabe von Patrick/PPC: Die Seite soll Einsteiger
// mitnehmen, nicht nur Leute bedienen, die schon rechnen wollen). Muster von
// lichtblick.de: eine aufklappbare FAQ direkt auf der Startseite, vor dem
// ersten Vertiefungslink in den Ratgeber. Antworten stehen als reiner Text,
// weil dieselben Daten unten das FAQPage-JSON-LD speisen — Google verlangt
// Übereinstimmung zwischen sichtbarem Text und Strukturdaten (wie bei
// ArticleFaq.astro/ArticleLayout.astro). Jede Zahl stammt aus den bereits
// belegten Konstanten in calculate.js, nichts davon ist neu recherchiert.
const wasIstPv = [
  {
    frage: "Was ist Photovoltaik überhaupt?",
    antwort:
      "Photovoltaik wandelt Sonnenlicht direkt in elektrischen Strom um — nicht zu verwechseln mit Solarthermie, die Sonnenwärme für Heizung und Warmwasser nutzt. In den Solarzellen eines Moduls erzeugt einfallendes Licht eine Spannung; eine Anlage auf dem Dach liefert damit Gleichstrom, den ein Wechselrichter in Haushaltsstrom umwandelt.",
  },
  {
    frage: "Was bedeutet kWp, und wie viel Strom liefert das?",
    antwort:
      "kWp (Kilowattpeak) ist die installierte Modulleistung unter Normbedingungen — die Größenangabe der Anlage, nicht der tatsächliche Ertrag. Als bundesweite Faustregel liefert ein Kilowattpeak im Schnitt rund 950 Kilowattstunden Strom im Jahr (Fraunhofer ISE); ein heute übliches 420-Wp-Modul braucht dafür etwa 1,85 m² Dachfläche.",
  },
  {
    frage: "Eigenverbrauch, Einspeisung, Autarkie — was ist der Unterschied?",
    antwort: `Eigenverbrauch ist der Anteil des erzeugten Solarstroms, den Sie selbst nutzen, statt ihn einzuspeisen. Autarkie ist etwas anderes: der Anteil Ihres gesamten Strombedarfs, den die Anlage deckt — eine kleine Anlage kann praktisch alles selbst verbrauchen und trotzdem nur einen Bruchteil des Bedarfs decken. Aktuell spart selbst verbrauchter Strom rund ${ct(STROMPREIS)} ct/kWh, eingespeister bringt bei Anlagen bis 10 kWp ${ct(EINSPEISE)} ct/kWh.`,
  },
  {
    frage: "Brauche ich einen Batteriespeicher?",
    antwort:
      "Ohne Speicher erreicht eine gut ausgelegte Anlage laut ADAC-Richtwerten einen Autarkiegrad von etwa 30–55 % — den Rest liefert weiter das Netz, weil abends und nachts kein Solarstrom anfällt. Ein Speicher kann das erhöhen, bis zu einer praktischen Obergrenze von rund 85 % (HTW Berlin). Ob sich die Anschaffung lohnt, hängt von Verbrauch, Anlagengröße und Speicherpreis ab — das rechnet der Speicherrechner für Ihre eigenen Werte durch.",
  },
  {
    frage: "Wie lange dauert es, bis sich eine Anlage bezahlt macht?",
    antwort:
      "Das hängt von Anlagengröße, Standort, Verbrauch und den aktuellen System- und Strompreisen ab — eine pauschale Angabe ohne diese Werte wäre unseriös. Unser Rechner nutzt echte PVGIS-Satellitendaten für Ihre Postleitzahl und die aktuellen gesetzlichen Vergütungssätze, um die Amortisation für Ihr konkretes Dach zu berechnen.",
  },
];

const wasIstPvLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: wasIstPv.map((f) => ({
    "@type": "Question",
    name: f.frage,
    acceptedAnswer: { "@type": "Answer", text: f.antwort },
  })),
};
---

<BaseLayout
  title="Photovoltaik-Ratgeber & PV-Rechner | Photovoltaik Aktuell"
  description="Unabhängiger Ratgeber zu Photovoltaik-Kosten, Förderung, Speicher und Einspeisevergütung — plus PV-Rechner mit echten PVGIS-Satellitendaten für Ihren Standort."
>
  <script type="application/ld+json" set:html={JSON.stringify(wasIstPvLd)} />

  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-text">
        <h1>Was Ihr Dach wirklich bringt — nachgerechnet, nicht geschätzt</h1>
        <p class="hero-lead">
          Postleitzahl eingeben — wir holen die Sonneneinstrahlung für genau
          diese Koordinaten aus den Satellitendaten der EU-Kommission. Jede
          Zahl mit Quelle und Stand.
        </p>

        <!-- Der Einstieg ist die Postleitzahl, nicht ein Knopf: Sie ist die
             erste Angabe, die der Rechner ohnehin braucht, und sie kostet
             fünf Ziffern statt eines Sprungs ins Ungewisse. Muster von
             lichtblick.de, wo der Tarifrechner mit dem Ortsfeld beginnt.
             Bewusst ein echtes <form method="get">: Ohne JavaScript
             funktioniert es genauso, der Wizard liest die PLZ auf der
             Zielseite aus `?plz=` (siehe Wizard.jsx). -->
        <form class="hero-start" action="/rechner/photovoltaik/" method="get">
          <div class="hero-feld">
            <label for="hero-plz">Postleitzahl</label>
            <input
              id="hero-plz"
              name="plz"
              type="text"
              inputmode="numeric"
              autocomplete="postal-code"
              pattern="[0-9]{5}"
              maxlength="5"
              required
              placeholder="10115"
            />
          </div>
          <button type="submit" class="knopf-primaer">Ertrag berechnen</button>
        </form>
      </div>

      <div class="hero-grafik">
        <figure class="hero-bild">
          <Image
            src={heroBild}
            alt="Streiflicht über einer zusammenhängenden Fläche von Solarmodulen, die Zellstruktur der einzelnen Module ist erkennbar"
            widths={[640, 960, 1280, 1800]}
            sizes="(min-width: 860px) 46vw, 100vw"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Der Mini-Rechner liegt auf der Kante zwischen Hero und Rechner-Band,
       statt als weitere Kachel weiter unten zu warten: Wer auf der Startseite
       landet, hat nach zwei Sekunden eine eigene Zahl vor sich, ohne Klick und
       ohne Standortabfrage. Muster von lichtblick.de (Tarifrechner auf der
       Bandkante) und zolar (Rechner vor dem Erklärtext). `client:load`, weil
       die Karte der aktive Inhalt der Stelle ist und nicht Randdekor. -->
  <div class="hero-rechner">
    <div class="container">
      <div class="hero-rechner-karte">
        <RechnerWidget client:load variante="hero" />
      </div>
    </div>
  </div>

  <!-- Einstiegsblock für Leser, die noch nicht rechnen, sondern erst
       verstehen wollen (Vorgabe Patrick/PPC). Muster von lichtblick.de:
       eine aufklappbare FAQ direkt auf der Startseite. Bewusst zwischen dem
       Quellenband und dem Ratgeber — wer den Zahlen gerade vertraut hat,
       bekommt hier die Grundlagen dazu, bevor er zu den Artikeln weiterzieht
       oder zurück zum Rechner springt. -->
  <section class="pv-erklaert container">
    <div class="pv-erklaert-spalten">
    <div class="pv-erklaert-text">
    <div class="abschnitt-kopf">
      <h2>Was ist Photovoltaik?</h2>
      <p>
        Fünf Fragen, die vor dem Rechnen stehen — mit denselben Zahlen wie
        oben, nicht mit Anbieter-Schätzungen.
      </p>
    </div>

    <p class="pv-erklaert-intro">
      Kurz gesagt: Solarmodule wandeln Sonnenlicht in Strom, ein
      Wechselrichter macht daraus nutzbaren Haushaltsstrom, und was Sie nicht
      selbst verbrauchen, geht gegen Vergütung ins Netz. Die <Definition begriff="Anlagengröße">
        In kWp (Kilowattpeak) — der installierten Modulleistung unter
        Normbedingungen, nicht der tatsächlichen Stromerzeugung.
      </Definition> bestimmt, wie viel davon zusammenkommt; wie viel Sie <Definition begriff="selbst nutzen">
        Der Eigenverbrauch — nicht zu verwechseln mit der Autarkie, siehe
        zweite Frage unten.
      </Definition>, hängt von Ihrem Verbrauchsprofil ab.
    </p>

    <div class="pv-erklaert-liste">
      {wasIstPv.map((f) => (
        <details class="pv-erklaert-item">
          <summary>{f.frage}</summary>
          <p>{f.antwort}</p>
        </details>
      ))}
    </div>

    <a href="/ratgeber/wie-funktioniert-eine-photovoltaikanlage/" class="pv-erklaert-mehr">
      Ausführlich erklärt: Wie funktioniert eine Photovoltaikanlage? →
    </a>
    </div>

    {/* Bild rechts neben dem Frageblock. Es füllt nicht nur Platz: Ohne es
        stand eine 568px schmale Textspalte allein auf einer 1140px breiten
        Fläche, und die rechte Seitenhälfte war auf voller Abschnittshöhe
        leer.

        Ohne Bildunterschrift und ohne jede Zuschreibung — das Foto darf
        nicht als "unsere Monteure" oder als Referenzanlage lesbar werden,
        beides gibt es nicht (§ 5 UWG, siehe CLAUDE.md). Der Alt-Text
        beschreibt deshalb nur, was zu sehen ist, und behauptet nichts. */}
    <figure class="pv-erklaert-bild">
      <Image
        src={erklaertBild}
        alt="Zwei Monteure befestigen Solarmodule auf einem Ziegeldach"
        widths={[400, 550]}
        sizes="(min-width: 1000px) min(44vw, 550px), 100vw"
        loading="lazy"
        decoding="async"
      />
    </figure>
    </div>
  </section>

  <section class="ratgeber">
    <div class="container">
    <div class="abschnitt-kopf">
      <h2>Neu im Ratgeber</h2>
      <p>Von den Grundlagen bis zur Checkliste vor dem Kauf.</p>
    </div>

    {/* Dieselbe Karte wie auf /ratgeber/ (ArtikelKarte.astro) statt einer
        eigenen Zeilenliste mit 108px-Vorschau. Zwei Gründe: Die Briefmarken
        zeigten vom Foto nichts, und eine zweite Listenform für dieselbe Sache
        heißt, dass jede Änderung an Ratgeber-Karten hier vergessen wird.
        Drei statt vier Artikel — vier ergäben in einem Dreierraster eine
        zweite Reihe mit einer einzelnen Karte. */}
    <ul class="artikel-raster">
      {neueste.map((a) => (
        <li>
          <ArtikelKarte artikel={a} mitKategorie />
        </li>
      ))}
    </ul>

    <a href="/ratgeber/" class="alle-artikel">
      Alle {nf.format(artikel.length)} Artikel ansehen →
    </a>
    </div>
  </section>

  <!-- Die übrigen Rechner stehen hier als Register, nicht als Kartenwand:
       gruppiert nach der Frage, die jemand im Kopf hat, und erst NACH dem
       Quellenband. Wer gerade seine erste Zahl bekommen hat, bekommt nicht
       sofort zehn gleichwertige Alternativen vorgehalten. Dieselbe
       Gruppierung trägt das Nav-Panel im Header (src/lib/rechner.js). -->
  <section class="weitere container">
    <div class="abschnitt-kopf">
      <h2>Für die Frage danach</h2>
      <p>
        Zehn weitere Rechner auf derselben Datenbasis — jeder beantwortet
        genau eine Frage, keiner verlangt eine Anmeldung.
      </p>
    </div>

    <div class="weitere-gruppen">
      {gruppen.map((g) => (
        <section class="weitere-gruppe">
          <h3>{g.titel}</h3>
          <ul>
            {g.eintraege.filter((r) => r.slug !== "photovoltaik").map((r) => {
              const Signet = SIGNET[r.slug];
              return (
                <li>
                  <a href={`/rechner/${r.slug}/`}>
                    {Signet && <span class="rechner-signet" aria-hidden="true"><Signet size={26} /></span>}
                    <span class="rechner-name">{r.kurz}</span>
                    <span class="rechner-zweck">{r.beschreibung}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>

  {/* Abschluss der Seite. Bewusst KEIN vollflächig oranges Band mit demselben
      Link wie oben — genau das stand hier bis August 2026 und wurde entfernt
      (Vollflächen-Akzent am Seitenende ist ein bekannter Generierungs-Tell,
      und dieselbe Einladung ein drittes Mal lauter zu wiederholen überzeugt
      niemanden). Stattdessen zwei verschiedene nächste Schritte für zwei
      verschiedene Absichten, auf dem normalen Seitengrund mit 1px-Rand.
      Die vier Schritte sind nicht geschätzt, sondern die tatsächlichen
      Schritte des Wizards — wer weiß, was auf ihn zukommt, klickt eher. */}
  <section class="abschluss container">
    <div class="abschluss-karte">
      <div class="abschluss-haupt">
        <h2>Vier Angaben, dann steht die Zahl</h2>
        <p>
          Postleitzahl, Dachfläche, Stromverbrauch, Speicher — mehr fragt der
          ausführliche Rechner nicht. Ergebnis ohne Anmeldung, ohne
          E-Mail-Adresse.
        </p>
        <a href="/rechner/photovoltaik/" class="abschluss-knopf">
          Ertrag für mein Dach berechnen →
        </a>
      </div>
      <div class="abschluss-neben">
        <p class="abschluss-neben-titel">Lieber erst verstehen?</p>
        <p class="abschluss-neben-text">
          Die Grundlagen erklären Module, Wechselrichter und Speicher am
          tatsächlichen Stromweg durchs Haus.
        </p>
        <a href="/ratgeber/wie-funktioniert-eine-photovoltaikanlage/" class="abschluss-link">
          Wie funktioniert eine Photovoltaikanlage? →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */

  /* Millimeterpapier-Raster hinter dem Hero-Band — und NUR dort.
     Begründung, damit es niemand versehentlich über die ganze Seite zieht:
     Die Seite argumentiert durchgehend mit belegten Zahlen und soll wie ein
     Messprotokoll aussehen, nicht wie eine Werbeseite (siehe Kopfkommentar
     oben). Ein feines technisches Raster sagt genau das. Ein Farbverlauf,
     eine Mesh-Fläche oder weichgezeichnete Farbflecken sagen das Gegenteil
     und sind das bekannteste Merkmal generierter Landingpages
     (Design-Regeln 2 und 5).
     Umsetzung bewusst mit harten Farbstopps: Das rendert als 1px-Linie, nicht
     als Verlauf. Ein einziger Farbwert, 3,5% Deckkraft — sichtbar als
     Struktur, nicht als Muster. Die Untergrenze dafür ist die Trennlinie des
     Bands selbst, deshalb braucht es keine Ausblendung nach unten. */
  .hero {
    border-bottom: 1px solid var(--color-border);
    background-image:
      linear-gradient(to right, rgba(20, 27, 34, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(20, 27, 34, 0.035) 1px, transparent 1px);
    /* 32px = der Grundabstand des Layouts, nicht frei gewählt. */
    background-size: 32px 32px;
    /* Der Ursprung liegt auf der linken Textkante, nicht in der Seitenmitte:
       So fällt eine Rasterlinie exakt auf die Kante, an der auch Überschrift,
       Eingabefeld und jeder andere Abschnitt beginnen. Ein frei laufendes
       Raster wäre Dekoration; eines, das am Satzspiegel einrastet, gehört
       zum Layout. Unterhalb von 1180px ist der Container nicht gedeckelt,
       die Textkante liegt dann bei 20px. */
    background-position: 20px top;
  }

  @media (min-width: 1180px) {
    .hero {
      /* 590 = halbe Containerbreite (1180/2), minus 20px Innenabstand. */
      background-position: calc(50% - 570px) top;
    }
  }

  .hero-inner {
    display: grid;
    gap: clamp(24px, 5vw, 64px);
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 5vw, 60px);
    align-items: center;
  }

  /* Asymmetrisch: der Text trägt mehr Gewicht als die Grafik, statt beide
     Spalten gleich breit zu setzen. */
  @media (min-width: 860px) {
    .hero-inner {
      grid-template-columns: 1.02fr 0.98fr;
    }
  }

  /* 3,75 rem über drei Zeilen füllten den gesamten ersten Bildschirm und
     drückten das Eingabefeld unter die Falz — die Überschrift war dann das
     einzige, was jemand sah. 3 rem trägt dieselbe Stimme und lässt Feld und
     Hinweis mit in den ersten Blick. */
  .hero h1 {
    font-size: clamp(2.125rem, 4.2vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 16px;
    max-width: 20ch;
  }

  .hero-lead {
    margin: 0 0 26px;
    max-width: 44ch;
    font-size: clamp(1rem, 1.6vw, 1.0625rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Ein Auftritt beim Laden, gestaffelt — nicht drei verstreute Effekte.
     Ruhezustand ist der fertige Zustand: die Elemente sind ohne CSS-
     Animation sichtbar, die Animation blendet sie nur ein. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1,
    .hero-lead,
    .hero-start {
      animation: auftritt 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-lead { animation-delay: 0.08s; }
    .hero-start { animation-delay: 0.16s; }
  }

  @keyframes auftritt {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  /* Feld und Knopf sitzen in einer Zeile und teilen dieselbe Höhe — das
     Feld ist der Einstieg, der Knopf bestätigt ihn. Am Handy bricht die
     Zeile um, der Knopf läuft dann über die volle Breite. */
  .hero-start {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 10px;
  }

  .hero-feld {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 200px;
  }

  .hero-feld label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .hero-feld input {
    width: 100%;
    height: 50px;
    padding: 0 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
