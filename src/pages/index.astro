---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ertragskurve from "../components/Ertragskurve.astro";
import { getCollection } from "astro:content";
import { categoryLabel } from "../lib/categories.js";
import { RECHNER } from "../lib/rechner.js";
import {
  STROMPREIS,
  EINSPEISE,
  KOSTEN_PRO_KWP,
  ERTRAG_PRO_KWP,
} from "../lib/calculate.js";
import {
  IconRechnerPhotovoltaik,
  IconRechnerKombi,
  IconRechnerRendite,
  IconRechnerSpeicher,
  IconRechnerBalkonkraftwerk,
  IconRechnerCo2,
  IconRechnerGestehungskosten,
  IconRechnerReinigung,
  IconRechnerEauto,
  IconRechnerSteuer,
  IconRechnerMieterstrom,
} from "../components/IconsRechner.jsx";

// Gestaltungsansatz: Die Seite argumentiert durchgehend mit belegten Zahlen —
// also sieht sie aus wie ein Messprotokoll, nicht wie eine Werbeseite. Kein
// Verlaufsbanner, keine Sonnen-Symbole, keine lachende Familie auf dem Dach;
// das sind die Reflexe, die jede zweite Solar-Landingpage bedient.
//
// EIN Signature-Element (CLAUDE.md Design-Regel 11): die Ertragskurve im
// Hero, gezeichnet aus denselben Monatsanteilen, mit denen der Rechner
// arbeitet. Alles andere bleibt bewusst ruhig.
//
// Tonale Gliederung (neu): Die Seite lief vorher durchgehend in Off-White
// mit 1-px-Rändern — jeder Abschnitt sah aus wie der davor, nichts trug
// Gewicht. Jetzt drei Ebenen: helle Arbeitsflächen (Hero, Rechner,
// Ratgeber), EINE dunkle Platte in Brand-Navy für die Quellen (das ist das
// inhaltliche Zentrum der Seite und darf wie ein Prüfsiegel wirken) und EIN
// Akzentfeld in PPC-Orange ganz am Schluss für die Handlung. Das Orange
// bleibt damit dem Handeln vorbehalten (Design-Regel 2), taucht aber
// endlich einmal in Flächengröße auf, statt nur als 40-px-Knopf.
//
// Bewusst KEIN Eyebrow-Label über jedem Abschnitt — das wiederholte
// Kleinversalien-Kicker-Muster ist ein bekannter Generierungs-Tell. Die
// Überschriften tragen sich selbst.
const artikel = (await getCollection("articles")).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);
const neueste = artikel.slice(0, 4);

const hauptRechner = RECHNER.find((r) => r.slug === "photovoltaik");
const weitereRechner = RECHNER.filter((r) => r.slug !== "photovoltaik");

// Zeichen je Rechner — dieselbe Zuordnung wie auf /rechner/. Ohne
// client:-Direktive rendert Astro sie zu statischem SVG, die Seite lädt
// dafür kein JavaScript. Die Startseite hatte bisher außer der Ertragskurve
// keinerlei Bildzeichen; die elf Signets liegen längst im Projekt.
const SIGNET = {
  photovoltaik: IconRechnerPhotovoltaik,
  kombi: IconRechnerKombi,
  rendite: IconRechnerRendite,
  speicher: IconRechnerSpeicher,
  balkonkraftwerk: IconRechnerBalkonkraftwerk,
  co2: IconRechnerCo2,
  gestehungskosten: IconRechnerGestehungskosten,
  reinigung: IconRechnerReinigung,
  eauto: IconRechnerEauto,
  steuer: IconRechnerSteuer,
  mieterstrom: IconRechnerMieterstrom,
};
const HauptSignet = SIGNET[hauptRechner.slug];

const nf = new Intl.NumberFormat("de-DE");
const ct = (eur) =>
  new Intl.NumberFormat("de-DE", { minimumFractionDigits: 2 }).format(eur * 100);

// Rechenbasis-Leiste unter dem Hero. Die vier Werte werden NICHT hier
// notiert, sondern aus calculate.js importiert — dieselben Konstanten, mit
// denen der Rechner arbeitet. Eine abgetippte Zahl wäre genau der Fehler,
// den die Seite dem Wettbewerb vorwirft. Quelle und Stand stehen im
// Kommentar über der jeweiligen Konstante in calculate.js.
const basis = [
  { wert: `${ct(STROMPREIS)} ct`, einheit: "je kWh Haushaltsstrom", beleg: "BDEW, April 2026" },
  { wert: `${ct(EINSPEISE)} ct`, einheit: "Einspeisung bis 10 kWp", beleg: "Bundesnetzagentur, § 49 EEG" },
  { wert: `${nf.format(KOSTEN_PRO_KWP)} €`, einheit: "Systemkosten je kWp", beleg: "Fraunhofer ISE, 2026" },
  { wert: `${nf.format(ERTRAG_PRO_KWP)} kWh`, einheit: "Ertrag je kWp und Jahr", beleg: "Mittelwert Deutschland" },
];

// Die Quellen sind das eigentliche Unterscheidungsmerkmal gegenüber ADAC,
// co2online und den Anbieter-Rechnern — deshalb ein eigener Abschnitt statt
// einer Fußnote. Jede Zeile nennt, was diese Quelle konkret liefert; eine
// reine Logo-Reihe wäre eine Behauptung, das hier ist überprüfbar.
const quellen = [
  { name: "PVGIS", traeger: "EU Joint Research Centre", liefert: "Sonneneinstrahlung und Monatserträge für die exakten Koordinaten Ihrer Adresse" },
  { name: "BDEW", traeger: "Bundesverband der Energie- und Wasserwirtschaft", liefert: "Haushaltsstrompreis und saisonales Lastprofil" },
  { name: "Bundesnetzagentur", traeger: "§ 49 EEG", liefert: "Einspeisevergütung samt Staffelung über 10 kWp und Mieterstromzuschlag" },
  { name: "Fraunhofer ISE", traeger: "Institut für Solare Energiesysteme", liefert: "Systemkosten je kWp, Volllaststunden und Stromgestehungskosten" },
  { name: "HTW Berlin", traeger: "Stromspeicher-Inspektion", liefert: "Speicher-Dimensionierung und gemessene Systemwirkungsgrade" },
  { name: "ADAC", traeger: "Ratgeber Photovoltaik", liefert: "Autarkiegrade, Haushaltsverbrauch und Wechselrichter-Austauschkosten" },
  { name: "Umweltbundesamt", traeger: "Emissionsbilanz Strommix", liefert: "CO₂-Faktor je Kilowattstunde Netzstrom" },
];
---

<BaseLayout
  title="Photovoltaik-Ratgeber & PV-Rechner | Photovoltaik Aktuell"
  description="Unabhängiger Ratgeber zu Photovoltaik-Kosten, Förderung, Speicher und Einspeisevergütung — plus PV-Rechner mit echten PVGIS-Satellitendaten für Ihren Standort."
>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-text">
        <h1>Was Ihr Dach wirklich bringt — nachgerechnet, nicht geschätzt</h1>
        <p class="hero-lead">
          Elf Rechner auf einer gemeinsamen Datenbasis: Satellitendaten für
          Ihre Postleitzahl, Vergütungssätze aus dem Gesetz, Kosten aus der
          Marktstatistik. Jede Zahl mit Quelle und Stand.
        </p>
        <div class="hero-aktionen">
          <a href="/rechner/photovoltaik/" class="knopf-primaer">Ertrag berechnen</a>
          <a href="/ratgeber/" class="knopf-sekundaer">Zum Ratgeber</a>
        </div>
      </div>

      <div class="hero-grafik">
        <Ertragskurve kwp={10} />
      </div>
    </div>

    <!-- Rechenbasis: die vier Konstanten, aus denen sich alles Weitere
         ergibt. Keine Erfolgs-Kennzahlen ("10.000 Nutzer") — das wäre die
         Hero-Metrik-Schablone. Hier steht der Input, nicht der Applaus. -->
    <div class="basis">
      <dl class="basis-inner container">
        {basis.map((b) => (
          <div class="basis-eintrag">
            <dt class="zahl">{b.wert}</dt>
            <dd>
              <span class="basis-einheit">{b.einheit}</span>
              <span class="basis-beleg">{b.beleg}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="rechner container">
    <div class="abschnitt-kopf">
      <h2>Rechner</h2>
      <p>Konkrete Zahlen für Ihr Dach, Ihren Verbrauch, Ihren Standort.</p>
    </div>

    <a href={`/rechner/${hauptRechner.slug}/`} class="rechner-haupt">
      <div class="rechner-haupt-text">
        <span class="rechner-haupt-signet" aria-hidden="true"><HauptSignet size={30} /></span>
        <h3>{hauptRechner.title}</h3>
        <p>{hauptRechner.beschreibung}</p>
        <span class="rechner-haupt-link">Rechner starten →</span>
      </div>
      <dl class="rechner-haupt-fakten">
        <div>
          <dt>Datenquelle</dt>
          <dd>PVGIS-Satellitendaten</dd>
        </div>
        <div>
          <dt>Schritte</dt>
          <dd>4</dd>
        </div>
        <div>
          <dt>Ergebnis</dt>
          <dd>kWp, Ertrag, Ersparnis, Amortisation</dd>
        </div>
      </dl>
    </a>

    <ul class="rechner-liste">
      {weitereRechner.map((r) => {
        const Signet = SIGNET[r.slug];
        return (
          <li>
            <a href={`/rechner/${r.slug}/`}>
              {Signet && <span class="rechner-signet" aria-hidden="true"><Signet size={22} /></span>}
              <span class="rechner-name">{r.kurz}</span>
              <span class="rechner-zweck">{r.beschreibung}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="quellen">
    <div class="container">
      <div class="abschnitt-kopf quellen-kopf">
        <h2>Woher die Zahlen kommen</h2>
        <p>
          Keine Anbieter-Schätzungen. Jede Konstante in unseren Rechnern ist im
          Quellcode mit Quelle, Stand und Prüf-Rhythmus hinterlegt.
        </p>
      </div>

      <dl class="quellen-liste">
        {quellen.map((q) => (
          <div class="quelle">
            <dt>
              {q.name}
              <span class="quelle-traeger">{q.traeger}</span>
            </dt>
            <dd>{q.liefert}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="ratgeber container">
    <div class="abschnitt-kopf">
      <h2>Neu im Ratgeber</h2>
      <p>Von den Grundlagen bis zur Checkliste vor dem Kauf.</p>
    </div>

    <ul class="artikel-liste">
      {neueste.map((a) => (
        <li>
          <a href={`/ratgeber/${a.id}/`}>
            <span class="artikel-kategorie">{categoryLabel(a.data.category)}</span>
            <span class="artikel-titel">{a.data.title}</span>
            <span class="artikel-beschreibung">{a.data.description}</span>
          </a>
        </li>
      ))}
    </ul>

    <a href="/ratgeber/" class="alle-artikel">
      Alle {nf.format(artikel.length)} Artikel ansehen →
    </a>
  </section>

  <!-- Abschluss: das einzige Akzentfeld der Seite. Text in Tintenschwarz
       statt Weiß — Weiß auf #FF5200 erreicht nur 3,3:1 und wäre auf
       Fließtextgröße nicht lesbar; Tintenschwarz liegt bei ~7:1. -->
  <section class="abschluss">
    <div class="container abschluss-inner">
      <div>
        <h2>Rechnen Sie Ihr Dach durch</h2>
        <p>
          Vier Schritte, keine Anmeldung. Sie geben Dachfläche, Ausrichtung und
          Stromverbrauch ein, PVGIS liefert die Einstrahlung für Ihre
          Postleitzahl, am Ende steht die Amortisation in Jahren.
        </p>
      </div>
      <a href="/rechner/photovoltaik/" class="knopf-dunkel">Ertrag berechnen →</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Der Footer setzt global 64 px Abstand nach oben — sinnvoll hinter einem
     Artikel, aber hier läge ein Streifen Seitenhintergrund zwischen dem
     Akzentfeld und dem Footer. Nur auf dieser Seite abgeschaltet. */
  .site-footer {
    margin-top: 0;
  }
</style>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */

  .hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    padding-top: clamp(48px, 8vw, 92px);
    padding-bottom: clamp(40px, 6vw, 72px);
    align-items: center;
  }

  /* Asymmetrisch: der Text trägt mehr Gewicht als die Grafik, statt beide
     Spalten gleich breit zu setzen. */
  @media (min-width: 860px) {
    .hero-inner {
      grid-template-columns: 1.02fr 0.98fr;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5.4vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 20px;
    max-width: 17ch;
  }

  .hero-lead {
    margin: 0 0 30px;
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.0625rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Ein Auftritt beim Laden, gestaffelt — nicht drei verstreute Effekte.
     Ruhezustand ist der fertige Zustand: die Elemente sind ohne CSS-
     Animation sichtbar, die Animation blendet sie nur ein. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1,
    .hero-lead,
    .hero-aktionen {
      animation: auftritt 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-lead { animation-delay: 0.08s; }
    .hero-aktionen { animation-delay: 0.16s; }
  }

  @keyframes auftritt {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  .hero-aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .knopf-primaer,
  .knopf-sekundaer {
    display: inline-flex;
    align-items: center;
    padding: 15px 28px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s,
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .knopf-primaer {
    background: var(--color-accent);
    color: #fff;
    border: 1px solid var(--color-accent);
  }

  .knopf-primaer:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .knopf-sekundaer {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .knopf-sekundaer:hover {
    border-color: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .knopf-primaer:hover { transform: none; }
  }

  /* ── Rechenbasis ────────────────────────────────────────────────────── */

  .basis {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .basis-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
  }

  @media (min-width: 820px) {
    .basis-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Trennlinien statt Karten: vier Werte, die zusammengehören, gehören in
     eine Zeile und nicht in vier Kästen. */
  .basis-eintrag {
    padding: 20px 22px 22px 0;
    border-left: 1px solid var(--color-border);
    padding-left: 22px;
  }

  .basis-eintrag:first-child {
    border-left: 0;
    padding-left: 0;
  }

  @media (max-width: 819px) {
    .basis-eintrag:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .basis-eintrag:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }

  .basis-eintrag dt {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-brand-navy);
    line-height: 1.1;
  }

  .basis-eintrag dd {
    margin: 6px 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .basis-einheit {
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--color-text-primary);
  }

  .basis-beleg {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* ── Gemeinsamer Abschnittskopf ─────────────────────────────────────── */

  .abschnitt-kopf {
    margin-bottom: 32px;
    max-width: 56ch;
  }

  .abschnitt-kopf h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    letter-spacing: -0.025em;
    margin: 0 0 10px;
  }

  .abschnitt-kopf p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 16px;
  }

  .rechner,
  .ratgeber {
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  /* ── Rechner ────────────────────────────────────────────────────────── */

  /* Der Hauptrechner bekommt bewusst eine andere Form als die übrigen zehn:
     eine Reihe identischer Kacheln würde verschweigen, dass genau einer
     davon mit echten Standortdaten arbeitet. */
  .rechner-haupt {
    display: grid;
    gap: 24px;
    padding: clamp(26px, 3.2vw, 38px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    margin-bottom: 20px;
    transition: border-color 0.15s, box-shadow 0.2s;
  }

  .rechner-haupt:hover {
    border-color: var(--color-accent);
  }

  @media (min-width: 760px) {
    .rechner-haupt {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }

  .rechner-haupt-signet {
    display: block;
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  .rechner-haupt h3 {
    font-size: var(--schrift-xl);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }

  .rechner-haupt-text p {
    margin: 0 0 18px;
    color: var(--color-text-secondary);
    font-size: 15.5px;
    line-height: 1.6;
    max-width: 44ch;
  }

  .rechner-haupt-link {
    font-weight: 600;
    font-size: 15px;
    color: var(--color-accent);
  }

  .rechner-haupt-fakten {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding-top: 4px;
  }

  .rechner-haupt-fakten dt {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 2px;
  }

  .rechner-haupt-fakten dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .rechner-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* Genau zwei Spalten: die zehn Nebenrechner gehen restlos auf. Mit
     auto-fit blieben bei vier Spalten zwei leere Zellen übrig, in denen
     der Rand-Hintergrund als grauer Block sichtbar wurde. */
  @media (min-width: 640px) {
    .rechner-liste {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Signet in eigener Spalte: es soll den Namen ankündigen, nicht über ihm
     schweben wie das Icon-über-jeder-Überschrift-Muster. */
  .rechner-liste a {
    display: grid;
    grid-template-columns: 22px 1fr;
    column-gap: 14px;
    height: 100%;
    padding: 18px 20px;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s;
  }

  .rechner-signet {
    grid-row: span 2;
    display: block;
    padding-top: 2px;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  .rechner-liste a:hover {
    background: var(--color-accent-subtle);
  }

  .rechner-liste a:hover .rechner-signet {
    color: var(--color-accent);
  }

  .rechner-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 5px;
  }

  .rechner-zweck {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* ── Quellen ────────────────────────────────────────────────────────── */

  /* Die einzige dunkle Platte der Seite. Sie trägt das Argument, mit dem
     sich dieses Produkt von ADAC- und Anbieter-Rechnern unterscheidet, und
     gibt der Seite gleichzeitig den tonalen Halt, der ihr in durchgehendem
     Off-White gefehlt hat. Brand-Navy, nicht Schwarz — Schwarz plus
     Neon-Akzent ist ein bekannter Generierungs-Tell (Design-Regel 5). */
  .quellen {
    background: var(--color-brand-navy);
    color: #fff;
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .quellen-kopf h2 {
    color: #fff;
  }

  /* Heller Text auf dunklem Grund wirkt dünner — 0,05 mehr Zeilenhöhe und
     eine kräftigere Sekundärfarbe (ca. 7:1 statt 3,1:1 mit #5A6570). */
  .quellen-kopf p {
    color: #C9CCD6;
    line-height: 1.65;
  }

  /* Typografische Liste statt Logo-Reihe oder Icon-Text-Pillen: Was eine
     Quelle liefert, ist überprüfbar — ein Logo ist nur eine Behauptung. */
  .quellen-liste {
    margin: 0;
    display: grid;
    gap: 0;
  }

  @media (min-width: 720px) {
    .quellen-liste {
      grid-template-columns: 1fr 1fr;
      column-gap: 48px;
    }
  }

  .quelle {
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .quelle dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15.5px;
    color: #fff;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 5px;
  }

  .quelle-traeger {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 12.5px;
    color: #A9AEBC;
  }

  .quelle dd {
    margin: 0;
    font-size: 14px;
