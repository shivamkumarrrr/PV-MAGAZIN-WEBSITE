---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, categoryLabel } from "../../../lib/categories.js";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import RechnerCta from "../../../components/RechnerCta.astro";
import ArtikelKarte from "../../../components/ArtikelKarte.astro";

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { kategorie: c.slug } }));
}

const { kategorie } = Astro.params;
const label = categoryLabel(kategorie);
const articles = (await getCollection("articles", (a) => a.data.category === kategorie)).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);

---

<BaseLayout
  title={`${label} | Photovoltaik-Ratgeber | Photovoltaik Aktuell`}
  description={`Alle Ratgeber-Artikel zum Thema ${label} rund um Photovoltaik.`}
>

  <section class="container cat-header">
    <Breadcrumb glieder={[{ name: "Ratgeber", href: "/ratgeber/" }, { name: label }]} />
    <h1>{label}</h1>
  </section>

  <section class="container">
    {articles.length === 0 && (
      <p class="empty">Für diese Kategorie sind noch keine Artikel veröffentlicht.</p>
    )}
    {articles.length > 0 && (
    <ul class="artikel-raster">
      {articles.map((a, i) => (
        <li>
          <ArtikelKarte artikel={a} vorrang={i < 3} />
        </li>
      ))}
    </ul>
    )}

    <RechnerCta
      variant="final"
      text="Die Zahlen aus diesen Artikeln für Ihr eigenes Dach — mit der Einstrahlung für Ihre Postleitzahl statt mit dem Bundesdurchschnitt."
    />
  </section>
</BaseLayout>

<style>
  /* Linksbündig auf Containerbreite, nicht zentriert in einer schmalen
     Lesespalte: Der Kopf steht über einem linksbündigen Kartenraster, und
     eine zentrierte Überschrift darüber liest sich als Fehlausrichtung. */
  .cat-header {
    /* `padding-block`, nicht die `padding`-Kurzform: Die Kurzform würde die
       seitlichen 20px von `.container` auf 0 setzen, und der Kopf stünde
       22px weiter links als das Kartenraster darunter. */
    padding-block: 40px 24px;
  }


  .cat-header h1 {
    font-size: 28px;
  }

  /* Dasselbe Raster wie auf /ratgeber/ — die Karte selbst liegt in
     ArtikelKarte.astro, damit Übersicht und Kategorieseite nicht wieder
     auseinanderlaufen. */
  .artikel-raster {
    list-style: none;
    margin: 0;
    padding: 0 0 56px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .artikel-raster li {
    display: flex;
  }

  @media (max-width: 520px) {
    .artikel-raster {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .empty {
    padding: 24px 0;
    color: var(--color-text-muted);
  }
</style>
