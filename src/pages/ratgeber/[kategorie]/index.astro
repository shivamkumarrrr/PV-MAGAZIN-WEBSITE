---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, categoryLabel } from "../../../lib/categories.js";

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { kategorie: c.slug } }));
}

const { kategorie } = Astro.params;
const label = categoryLabel(kategorie);
const articles = (await getCollection("articles", (a) => a.data.category === kategorie)).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ratgeber", item: new URL("/ratgeber/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: label, item: new URL(`/ratgeber/${kategorie}/`, Astro.site).toString() },
  ],
};
---

<BaseLayout
  title={`${label} | Photovoltaik-Ratgeber | Photovoltaik Aktuell`}
  description={`Alle Ratgeber-Artikel zum Thema ${label} rund um Photovoltaik.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <section class="prose cat-header">
    <nav class="breadcrumb"><a href="/ratgeber/">Ratgeber</a> / {label}</nav>
    <h1>{label}</h1>
  </section>

  <section class="container">
    <ul class="article-list">
      {articles.map((a) => (
        <li>
          <a href={`/ratgeber/${a.id}/`}>
            <h2>{a.data.title}</h2>
            <p>{a.data.description}</p>
          </a>
        </li>
      ))}
      {articles.length === 0 && <p class="empty">Für diese Kategorie sind noch keine Artikel veröffentlicht.</p>}
    </ul>
  </section>
</BaseLayout>

<style>
  .cat-header {
    padding: 40px 20px 24px;
  }

  .breadcrumb {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .cat-header h1 {
    font-size: 28px;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0 0 56px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .article-list a {
    display: block;
    padding: 20px 22px;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
  }

  .article-list a:hover {
    background: var(--color-accent-subtle);
  }

  .article-list h2 {
    font-size: 17px;
    margin: 0 0 4px;
  }

  .article-list p {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .empty {
    padding: 24px 0;
    color: var(--color-text-muted);
  }
</style>
