---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../../lib/categories.js";

// Vorher: 17 gleich große weiße Karten in einem 3-Spalten-Raster. Das ist das
// Muster, das jede KI-generierte Übersichtsseite produziert — und es half hier
// niemandem: Alle Artikel wirkten gleich wichtig, die Kategorie-Chips oben
// hatten keine Entsprechung in der Liste darunter, und die Beschreibungen
// waren auf drei schmale Spalten zerhackt.
//
// Jetzt ein echtes Register: nach Kategorie gruppiert, als typografische
// Zeilen. Die Gruppierung ist keine Dekoration, sie bildet die Struktur ab,
// die es ohnehin gibt (das `category`-Feld im Frontmatter) — und beantwortet
// die Frage, die jemand auf einer Übersichtsseite hat: "Was gibt es zu
// meinem Thema?"
const artikel = await getCollection("articles");

const gruppen = CATEGORIES.map((c) => ({
  ...c,
  artikel: artikel
    .filter((a) => a.data.category === c.slug)
    .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()),
})).filter((g) => g.artikel.length > 0);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ratgeber", item: new URL("/ratgeber/", Astro.site).toString() },
  ],
};

const nf = new Intl.NumberFormat("de-DE");
---

<BaseLayout
  title="Photovoltaik-Ratgeber | Photovoltaik Aktuell"
  description="Alle Artikel zu Photovoltaik: Kosten & Förderung, Technik, Speicher, Einspeisevergütung, Balkonkraftwerk, Ökobilanz und Checklisten — nach Kategorie sortiert."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="container">
    <header class="kopf">
      <h1>Ratgeber</h1>
      <p>
        {nf.format(artikel.length)} Artikel, nach Thema sortiert. Jede Zahl im
        Text mit Quelle — von den Grundlagen bis zur Checkliste vor dem Kauf.
      </p>
    </header>

    <nav class="sprung" aria-label="Zu einer Kategorie springen">
      {gruppen.map((g) => (
        <a href={`#${g.slug}`}>
          {g.label} <span class="anzahl">{g.artikel.length}</span>
        </a>
      ))}
    </nav>

    {gruppen.map((g) => (
      <section class="gruppe" id={g.slug}>
        <div class="gruppe-kopf">
          <h2>{g.label}</h2>
          <a href={`/ratgeber/${g.slug}/`} class="gruppe-link">
            Nur {g.label} →
          </a>
        </div>

        <ul class="eintraege">
          {g.artikel.map((a) => (
            <li>
              <a href={`/ratgeber/${a.id}/`}>
                <h3>{a.data.title}</h3>
                <p>{a.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .kopf {
    max-width: 44ch;
    padding: clamp(40px, 6vw, 68px) 0 clamp(24px, 3vw, 32px);
  }

  .kopf h1 {
    font-size: var(--schrift-2xl);
    margin: 0 0 12px;
  }

  .kopf p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--schrift-md);
    text-wrap: pretty;
  }

  /* Sprungmarken statt Filter-Chips: die Chips führten vorher auf eigene
     Unterseiten und rissen den Nutzer aus der Übersicht. Hier bleibt er auf
     der Seite; die Kategorieseiten sind weiter über jede Gruppe erreichbar. */
  .sprung {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--color-border);
  }

  .sprung a {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 7px 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--schrift-sm);
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }

  .sprung a:hover {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
  }

  .anzahl {
    font-size: var(--schrift-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .gruppe {
    padding: clamp(36px, 5vw, 56px) 0 0;
    scroll-margin-top: 24px;
  }

  .gruppe:last-of-type {
    padding-bottom: clamp(48px, 7vw, 80px);
  }

  .gruppe-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .gruppe-kopf h2 {
    font-size: var(--schrift-lg);
    margin: 0;
  }

  .gruppe-link {
    font-size: var(--schrift-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .gruppe-link:hover {
    color: var(--color-accent-hover);
  }

  /* Zeilen statt Karten. Der Titel trägt, die Beschreibung erklärt — beide
     linksbündig auf derselben Achse, damit die Augen beim Überfliegen nicht
     zwischen drei Spalten springen müssen. */
  .eintraege {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .eintraege li {
    border-top: 1px solid var(--color-border);
  }

  /* Beim Überfahren rückt die Zeile leicht ein. Über `transform` statt
     `padding-left`: letzteres löst bei jedem Frame ein neues Layout aus und
     ruckelt in einer langen Liste sichtbar. */
  .eintraege a {
    display: block;
    padding: 18px 16px 20px 0;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.15s;
  }

  .eintraege a:hover {
    background: var(--color-surface);
    transform: translateX(10px);
  }

  @media (prefers-reduced-motion: reduce) {
    .eintraege a {
      transition: background-color 0.15s;
    }
    .eintraege a:hover {
      transform: none;
    }
  }

  .eintraege h3 {
    font-size: var(--schrift-md);
    font-weight: 600;
    margin: 0 0 5px;
    max-width: 54ch;
  }

  .eintraege a:hover h3 {
    color: var(--color-accent-hover);
  }

  .eintraege p {
    margin: 0;
    font-size: var(--schrift-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 68ch;
    text-wrap: pretty;
  }
</style>
