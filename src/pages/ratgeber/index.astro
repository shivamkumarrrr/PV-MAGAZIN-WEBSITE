---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../../lib/categories.js";
import ArtikelKarte from "../../components/ArtikelKarte.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import RechnerCta from "../../components/RechnerCta.astro";

// Vorher: 17 gleich große weiße Karten in einem 3-Spalten-Raster. Das ist das
// Muster, das jede KI-generierte Übersichtsseite produziert — und es half hier
// niemandem: Alle Artikel wirkten gleich wichtig, die Kategorie-Chips oben
// hatten keine Entsprechung in der Liste darunter, und die Beschreibungen
// waren auf drei schmale Spalten zerhackt.
//
// Die Antwort darauf war zuerst ein Register aus typografischen Zeilen mit
// 108px-Vorschaubildern. Die Gruppierung stimmte und bleibt — sie bildet die
// Struktur ab, die es ohnehin gibt (das `category`-Feld im Frontmatter), und
// beantwortet die Frage, die jemand auf einer Übersichtsseite hat: "Was gibt
// es zu meinem Thema?"
//
// Die Zeilen selbst haben nicht getragen: Die Fotos waren in Briefmarkengröße
// nicht zu erkennen, ihre Oberkante sprang mit der Länge des Titels, und
// rechts blieb bei 1440px die halbe Seite leer. Seit September 2026 stehen in
// jeder Gruppe Karten (`ArtikelKarte.astro`) mit dem Foto in 16:9 über die
// volle Kartenbreite. Das ist NICHT die Rückkehr zur flachen Kartenwand von
// davor: Die Karten stehen weiterhin unter ihrer Kategorie, nicht in einem
// einzigen Raster aus siebzehn gleichwertigen Kacheln.
const artikel = await getCollection("articles");

const gruppen = CATEGORIES.map((c) => ({
  ...c,
  artikel: artikel
    .filter((a) => a.data.category === c.slug)
    .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()),
})).filter((g) => g.artikel.length > 0);


const nf = new Intl.NumberFormat("de-DE");
---

<BaseLayout
  title="Photovoltaik-Ratgeber | Photovoltaik Aktuell"
  description="Alle Artikel zu Photovoltaik: Kosten & Förderung, Technik, Speicher, Einspeisevergütung, Balkonkraftwerk, Ökobilanz und Checklisten — nach Kategorie sortiert."
>

  <div class="container">
    <header class="kopf">
      <Breadcrumb glieder={[{ name: "Ratgeber" }]} />
      <h1>Ratgeber</h1>
      <p>
        {nf.format(artikel.length)} Artikel, nach Thema sortiert. Jede Zahl im
        Text mit Quelle — von den Grundlagen bis zur Checkliste vor dem Kauf.
      </p>
    </header>

    {/* Empfehlung statt Pflicht: Die Sprungmarken bleiben voll nutzbar, wer
        gezielt sucht, muss hier nicht vorbei. Aber Grundlagen steht als
        Kategorie ohnehin zuerst (CATEGORIES.js) — dieser Hinweis macht die
        Reihenfolge explizit, statt sie nur zufällig zu treffen (Vorgabe
        Patrick/PPC: Einsteiger sollen wissen, wo sie anfangen). */}
    <a href="/ratgeber/wie-funktioniert-eine-photovoltaikanlage/" class="einstieg">
      <span class="einstieg-label">Neu beim Thema?</span>
      <span class="einstieg-titel">Erst die Grundlagen: Wie funktioniert eine Photovoltaikanlage? →</span>
    </a>

    <nav class="sprung" aria-label="Zu einer Kategorie springen">
      {gruppen.map((g) => (
        <a href={`#${g.slug}`}>
          {g.label} <span class="anzahl">{g.artikel.length}</span>
        </a>
      ))}
    </nav>

    {gruppen.map((g, gi) => (
      <section class="gruppe" id={g.slug}>
        <div class="gruppe-kopf">
          <h2>{g.label}</h2>
          <a href={`/ratgeber/${g.slug}/`} class="gruppe-link">
            Nur {g.label} →
          </a>
        </div>

        {/* Vier der acht Kategorien haben genau einen Artikel. Im
            Drei-Spalten-Raster stünde dort eine schmale Karte neben zwei
            leeren Spalten — das liest sich als Fehler, nicht als Absicht.
            Ein Artikel bekommt deshalb eine Querkarte über die volle Breite,
            zwei teilen sich die Breite zur Hälfte, ab drei greift das
            Raster. */}
        <ul class:list={["artikel-raster", `artikel-raster--${Math.min(g.artikel.length, 3)}`]}>
          {g.artikel.map((a, i) => (
            <li>
              <ArtikelKarte
                artikel={a}
                vorrang={gi === 0 && i < 3}
                ausrichtung={g.artikel.length === 1 ? "quer" : "hoch"}
              />
            </li>
          ))}
        </ul>
      </section>
    ))}

    {/* Die Übersicht hatte bis September 2026 keinen einzigen Weg zum
        Rechner — siebzehn Artikel, alle mit CTA, aber die Seite, die sie
        auflistet, endete im Nichts. Dieselbe Abschluss-Box wie am
        Artikelende, damit niemand eine zweite Form lernen muss. */}
    <RechnerCta
      variant="final"
      text="Statt weiterzulesen: Ertrag, Ersparnis und Amortisation für Ihr eigenes Dach — mit der Einstrahlung für Ihre Postleitzahl."
    />
  </div>
</BaseLayout>

<style>
  .kopf {
    max-width: 58ch;
    padding: clamp(40px, 6vw, 68px) 0 clamp(24px, 3vw, 32px);
  }

  .kopf h1 {
    font-size: var(--schrift-2xl);
    margin: 0 0 12px;
  }

  .kopf p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--schrift-md);
    text-wrap: pretty;
  }

  /* Ein Block, keine Pille — Design-Regel 6 verbietet wiederholte
     Icon-Text-Pillen als Trust-Badge-Muster, nicht einen einzelnen
     hervorgehobenen Hinweis. Akzent-Subtle als Fläche macht ihn von den
     Sprungmarken darunter unterscheidbar, ohne eine neue Farbe
     einzuführen. Bewusst KEIN Kleinversalien-Label über dem Titel — das
     ist derselbe Eyebrow-Tell, der an anderer Stelle im Projekt schon
     einmal entfernt wurde (siehe index.astro). ".einstieg-label" trägt
     normalen Satz, keine Versalien. */
  .einstieg {
    display: block;
    margin-bottom: 20px;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    background: var(--color-accent-subtle);
    text-decoration: none;
  }

  .einstieg-label {
    display: block;
    margin-bottom: 3px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .einstieg-titel {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--color-accent-hover);
  }

  .einstieg:hover .einstieg-titel {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Sprungmarken statt Filter-Chips: die Chips führten vorher auf eigene
     Unterseiten und rissen den Nutzer aus der Übersicht. Hier bleibt er auf
     der Seite; die Kategorieseiten sind weiter über jede Gruppe erreichbar. */
  .sprung {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--color-border);
  }

  .sprung a {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 7px 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--schrift-sm);
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }

  .sprung a:hover {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
  }

  .anzahl {
    font-size: var(--schrift-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .gruppe {
    padding: clamp(36px, 5vw, 56px) 0 0;
    scroll-margin-top: 24px;
  }

  .gruppe:last-of-type {
    padding-bottom: clamp(48px, 7vw, 80px);
  }

  .gruppe-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .gruppe-kopf h2 {
    font-size: var(--schrift-lg);
    margin: 0;
  }

  .gruppe-link {
    font-size: var(--schrift-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .gruppe-link:hover {
    color: var(--color-accent-hover);
  }

  /* Drei Spalten auf dem Desktop, zwei auf dem Tablet, eine auf dem Handy.
     `auto-fill` mit fester Mindestbreite statt fester Spaltenzahl: In den
     Gruppen stehen zwischen einem und fünf Artikeln, und eine einzelne Karte
     soll nicht über die volle Seitenbreite laufen — `minmax(280px, 1fr)`
     hält sie auf Spaltenbreite. */
  .artikel-raster {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  /* Ohne das strecken sich die <li> nicht auf Reihenhöhe, und die Karte darin
     kann nicht `height: 100%` einnehmen — dann steht die Fußzeile jeder Karte
     auf einer anderen Höhe, also genau der Fehler, den dieses Raster beheben
     soll. */
  .artikel-raster li {
    display: flex;
  }

  .artikel-raster--1 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .artikel-raster--2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .artikel-raster {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

</style>
