---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/gestehung/Wizard.jsx";
---

<BaseLayout
  title="Gestehungskostenrechner — Was kostet Ihre Solar-kWh? | Photovoltaik Aktuell"
  description="Berechnen Sie Ihre eigenen Stromgestehungskosten in ct/kWh und vergleichen Sie mit dem aktuellen Netzstrompreis — basierend auf der Fraunhofer-ISE-Methodik."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "Gestehungskosten" }]} />
    <h1>Gestehungskostenrechner</h1>
    <p>
      Was kostet eine selbst erzeugte Kilowattstunde Solarstrom wirklich —
      über die gesamte Lebensdauer der Anlage gerechnet? Drei kurze
      Schritte, dann sehen Sie Ihre Stromgestehungskosten in ct/kWh im
      direkten Vergleich zum aktuellen Netzstrompreis. Hintergrund und
      Methodik erklärt der Artikel{" "}
      <a href="/ratgeber/stromgestehungskosten-photovoltaik-erklaert/">
        Was kostet eine Kilowattstunde Solarstrom wirklich?
      </a>
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
