---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/steuer/Wizard.jsx";
---

<BaseLayout
  title="PV-Steuerrechner — Nullsteuersatz & Einkommensteuerbefreiung | Photovoltaik Aktuell"
  description="Wie viel sparen Sie durch den Mehrwertsteuer-Nullsteuersatz und die Einkommensteuerbefreiung Ihrer Photovoltaik-Anlage? Jetzt berechnen."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "Steuer" }]} />
    <h1>PV-Steuerrechner</h1>
    <p>
      Seit 2023 kaufen Sie Photovoltaikanlagen auf Wohngebäuden ohne
      Mehrwertsteuer, und die Erträge sind bis 30 kWp einkommensteuerfrei.
      Dieser Rechner zeigt, was der Nullsteuersatz gegenüber der alten
      Rechtslage konkret wert ist — und ob Ihre Anlage in den steuerfreien
      Bereich fällt.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
