---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/calculator/Wizard.jsx";
---

<BaseLayout
  title="Photovoltaik-Rechner — Ertrag & Ersparnis berechnen | Photovoltaik Aktuell"
  description="Berechnen Sie in 4 Schritten Anlagengröße, Jahresertrag, Ersparnis, Autarkiegrad und Amortisation Ihrer Solaranlage — auf Basis echter PVGIS-Satellitendaten für Ihren Standort."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "Photovoltaik" }]} />
    <h1>Photovoltaik-Rechner</h1>
    <p>
      Standort, Dach, Verbrauch, Speicher — vier kurze Schritte, dann sehen
      Sie Anlagengröße, Jahresertrag, Ersparnis, Autarkiegrad und
      Amortisation für Ihr eigenes Dach. Ertragsdaten stammen, wo verfügbar,
      direkt von PVGIS (EU Joint Research Centre); ohne Standortdaten
      rechnen wir mit einem bundesweiten Durchschnittswert.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>

  <section class="prose so-funktioniert">
    <h2>So funktioniert der Rechner</h2>
    <div class="schritte">
      <div class="schritt">
        <span class="schritt-nr">1</span>
        <h3>Standort</h3>
        <p>
          Ihre PLZ/Ort bestimmt über PVGIS (EU Joint Research Centre) den
          Ertrag dieses Dachs. Ohne Angabe rechnen wir mit einem bundesweiten
          Durchschnitt — das Ergebnis ist dann eine Größenordnung, keine
          Standortwahrheit.
        </p>
      </div>
      <div class="schritt">
        <span class="schritt-nr">2</span>
        <h3>Dach & Verbrauch</h3>
        <p>
          Aus Dachform, Ausrichtung und freier Fläche wird die maximale
          Anlagengröße abgeleitet. Ihr Jahresverbrauch bestimmt zusammen mit
          der Speichergröße, wie viel vom erzeugten Strom für Sie wert ist.
        </p>
      </div>
      <div class="schritt">
        <span class="schritt-nr">3</span>
        <h3>Ergebnis</h3>
        <p>
          Anlagengröße, Jahresertrag, Autarkiegrad, Investition, Ersparnis und
          Amortisation — alle Kennzahlen mit dem Hinweis, mit welchen
          Annahmen sie gerechnet wurden. Nichts davon ist ein Angebot.
        </p>
      </div>
    </div>
  </section>

  <section class="prose faq rechner-faq">
    <h2>Häufige Fragen zum Rechner</h2>
    <details class="faq-item">
      <summary>Sind die Ergebnisse ein Angebot eines Anbieters?</summary>
      <p>
        Nein. Der Rechner liefert eine fachliche Größenordnung auf Basis
        öffentlicher Datenquellen und durchschnittlicher Anbieterpreise —
        kein Angebot und keine Bindung. Ein Installateur-Angebot für Ihre
        konkrete Dachkonstruktion kann davon abweichen.
      </p>
    </details>
    <details class="faq-item">
      <summary>Welche Datenquellen stecken dahinter?</summary>
      <p>
        Ertragsdaten stammen von PVGIS des EU Joint Research Centre (öffentlich
        verfügbare Satellitendaten), Preisannahmen aus der Fraunhofer-ISE- und
        Branchen-Marktpreisübersicht, Strompreisannahmen aus dem
        BDEW-Durchschnitt. Alle Annahmen halten wir jährlich auf Stand und
        dokumentieren sie in den Artikeln.
      </p>
    </details>
    <details class="faq-item">
      <summary>Warum weicht mein Rechnergebnist von anderen Rechnern ab?</summary>
      <p>
        Weil die meisten PV-Rechner optimistisch sind: Sie nehmen volle
        Süd-Ausrichtung, ideale Neigung und 100% Eigenverbrauch ohne Dach- und
        Verschattungsverluste an. Dieser Rechner rechnet mit realistischen
        Ertragsdaten und Ihren Eingaben — wer die "5 Jahre Amortisation" sehen
        will, findet die woanders.
      </p>
    </details>
    <details class="faq-item">
      <summary>Berücksichtigt der Rechner Inflation und Strompreissteigerung?</summary>
      <p>
        Nein. Die Amortisation ist bewusst eine einfache statische Rechnung
        mit heutigen Preisen und heutiger Vergütung. Inflations- oder
        Strompreissteigerungs-Annahmen schmuggeln Optimismus in eine
        Zahl, die Prüfbericht-Qualität hat — wir lassen sie weg.
      </p>
    </details>
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .wizard-wrap {
    padding-bottom: 48px;
  }

  .so-funktioniert {
    max-width: 900px;
    padding: 0 20px 12px;
  }

  .so-funktioniert h2 {
    font-size: 24px;
  }

  .schritte {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .schritt {
    padding: 20px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .schritt-nr {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-brand-navy);
    color: var(--color-surface);
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 12px;
  }

  .schritt h3 {
    font-size: 16px;
    margin: 0 0 6px;
  }

  .schritt p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .rechner-faq {
    max-width: 820px;
    padding: 28px 20px 64px;
  }

  .rechner-faq .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item summary {
    cursor: pointer;
    padding: 14px 28px 14px 0;
    font-weight: 600;
    font-size: 16px;
    color: var(--color-text-primary);
    position: relative;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "";
    position: absolute;
    right: 6px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.15s;
  }

  .faq-item[open] summary::after {
    transform: translateY(-30%) rotate(225deg);
  }

  .faq-item summary:hover {
    color: var(--color-accent-hover);
  }

  .faq-item p {
    margin: 0 0 16px;
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item summary::after {
      transition: none;
    }
  }
</style>
