---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Wizard from "../../components/calculator/Wizard.jsx";
---

<BaseLayout
  title="Photovoltaik-Rechner — Ertrag & Ersparnis berechnen | Photovoltaik Aktuell"
  description="Berechnen Sie in 4 Schritten Anlagengröße, Jahresertrag, Ersparnis, Autarkiegrad und Amortisation Ihrer Solaranlage — auf Basis echter PVGIS-Satellitendaten für Ihren Standort."
>
  <section class="prose rechner-intro">
    <nav class="breadcrumb"><a href="/rechner/">Rechner</a> / Photovoltaik</nav>
    <h1>Photovoltaik-Rechner</h1>
    <p>
      Standort, Dach, Verbrauch, Speicher — vier kurze Schritte, dann sehen
      Sie Anlagengröße, Jahresertrag, Ersparnis, Autarkiegrad und
      Amortisation für Ihr eigenes Dach. Ertragsdaten stammen, wo verfügbar,
      direkt von PVGIS (EU Joint Research Centre); ohne Standortdaten
      rechnen wir mit einem bundesweiten Durchschnittswert.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  .rechner-intro {
    padding: 32px 20px 20px;
  }

  .breadcrumb {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
