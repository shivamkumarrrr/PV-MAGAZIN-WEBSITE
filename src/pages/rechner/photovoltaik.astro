---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import RechnerSeiteInhalt from "../../components/RechnerSeiteInhalt.astro";
import Wizard from "../../components/calculator/Wizard.jsx";
---

<BaseLayout
  title="Photovoltaik-Rechner — Ertrag & Ersparnis berechnen | Photovoltaik Aktuell"
  description="Berechnen Sie in 4 Schritten Anlagengröße, Jahresertrag, Ersparnis, Autarkiegrad und Amortisation Ihrer Solaranlage — auf Basis echter PVGIS-Satellitendaten für Ihren Standort."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "Photovoltaik" }]} />
    <h1>Photovoltaik-Rechner</h1>
    <p>
      Standort, Dach, Verbrauch, Speicher — vier kurze Schritte, dann sehen
      Sie Anlagengröße, Jahresertrag, Ersparnis, Autarkiegrad und
      Amortisation für Ihr eigenes Dach. Ertragsdaten stammen, wo verfügbar,
      direkt von PVGIS (EU Joint Research Centre); ohne Standortdaten
      rechnen wir mit einem bundesweiten Durchschnittswert.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>

  <RechnerSeiteInhalt
    slug="photovoltaik"
    name="Photovoltaik-Rechner"
    beschreibung="Anlagengröße, Jahresertrag, Ersparnis, Autarkiegrad und Amortisation — auf Basis echter PVGIS-Satellitendaten für Ihren Standort."
  />
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .wizard-wrap {
    padding-bottom: 48px;
  }

</style>
