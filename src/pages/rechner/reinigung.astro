---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/reinigung/Wizard.jsx";
---

<BaseLayout
  title="PV-Reinigungsrechner — Lohnt sich die Reinigung? | Photovoltaik Aktuell"
  description="Wie viel Ertrag kostet Sie Verschmutzung durch Staub, Pollen oder Vogelkot — und rechnet sich eine professionelle Reinigung? Jetzt berechnen."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "Reinigung" }]} />
    <h1>PV-Reinigungsrechner</h1>
    <p>
      Schmutz senkt den Ertrag Ihrer Anlage — wie stark, hängt von Umgebung,
      Dachneigung und der Zeit seit der letzten Reinigung ab. Dieser Rechner
      stellt dem jährlichen Ertragsverlust die Kosten einer professionellen
      Reinigung gegenüber. Bei gut geneigten Dächern in freier Lage ist die
      Antwort oft: gar nicht reinigen.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
