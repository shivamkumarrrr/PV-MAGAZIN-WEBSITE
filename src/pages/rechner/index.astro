---
import BaseLayout from "../../layouts/BaseLayout.astro";
// Die Tool-Liste lag früher als lokales Array in dieser Datei — dieselbe
// Information brauchte aber auch RechnerCta.astro für den Titel der
// "Passend dazu"-Box. Jetzt eine Quelle der Wahrheit: src/lib/rechner.js.
import { RECHNER } from "../../lib/rechner.js";

// Alle gelisteten Rechner sind live. Der frühere "status"-Schalter samt
// "Bald verfügbar"-Karte ist entfallen, weil kein Eintrag ihn mehr nutzte.
const tools = RECHNER;
---

<BaseLayout
  title="PV-Rechner — Photovoltaik-Tools | Photovoltaik Aktuell"
  description="Alle Photovoltaik-Rechner von Photovoltaik Aktuell an einem Ort: PV-Rechner mit echten PVGIS-Daten, Speicher, Rendite, Balkonkraftwerk, CO2, Gestehungskosten, Reinigung, E-Auto, Steuer und Mieterstrom."
>
  <section class="prose rechner-header">
    <h1>Rechner</h1>
    <p>Konkrete Zahlen statt Schätzungen — für Ihr Dach, Ihren Verbrauch, Ihren Standort.</p>
  </section>

  <section class="container tool-grid">
    {tools.map((t) => (
      <a href={`/rechner/${t.slug}/`} class="tool-card">
        <h2>{t.title}</h2>
        <p>{t.beschreibung}</p>
        <span class="tool-link">Jetzt rechnen →</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .rechner-header {
    padding: 40px 20px 24px;
  }

  .rechner-header h1 {
    font-size: 30px;
  }

  .rechner-header p {
    color: var(--color-text-secondary);
    font-size: 16px;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
    padding-bottom: 56px;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 24px 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  a.tool-card {
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }

  a.tool-card:hover {
    border-color: var(--color-accent);
  }

  .tool-card h2 {
    font-size: 18px;
    margin: 0 0 8px;
  }

  .tool-card p {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 14px;
    flex-grow: 1;
  }

  .tool-link {
    font-weight: 600;
    font-size: 14px;
  }
</style>
