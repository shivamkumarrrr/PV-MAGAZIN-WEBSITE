---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
// Die Tool-Liste lag früher als lokales Array in dieser Datei — dieselbe
// Information brauchte aber auch RechnerCta.astro für den Titel der
// "Passend dazu"-Box. Jetzt eine Quelle der Wahrheit: src/lib/rechner.js.
import { RECHNER } from "../../lib/rechner.js";
import {
  IconRechnerPhotovoltaik,
  IconRechnerKombi,
  IconRechnerRendite,
  IconRechnerSpeicher,
  IconRechnerBalkonkraftwerk,
  IconRechnerCo2,
  IconRechnerGestehungskosten,
  IconRechnerReinigung,
  IconRechnerEauto,
  IconRechnerSteuer,
  IconRechnerMieterstrom,
} from "../../components/IconsRechner.jsx";

// Zeichen je Rechner. Bewusst HIER und nicht in src/lib/rechner.js: die
// Liste ist reine Daten und wird auch von RechnerCta.astro gelesen — sie
// soll keine React-Komponenten mitschleppen. Ohne client:-Direktive
// rendert Astro die Zeichen zu statischem SVG, die Seite lädt dafür kein
// JavaScript.
const SIGNET = {
  photovoltaik: IconRechnerPhotovoltaik,
  kombi: IconRechnerKombi,
  rendite: IconRechnerRendite,
  speicher: IconRechnerSpeicher,
  balkonkraftwerk: IconRechnerBalkonkraftwerk,
  co2: IconRechnerCo2,
  gestehungskosten: IconRechnerGestehungskosten,
  reinigung: IconRechnerReinigung,
  eauto: IconRechnerEauto,
  steuer: IconRechnerSteuer,
  mieterstrom: IconRechnerMieterstrom,
};

// Alle gelisteten Rechner sind live. Der frühere "status"-Schalter samt
// "Bald verfügbar"-Karte ist entfallen, weil kein Eintrag ihn mehr nutzte.
const tools = RECHNER;
---

<BaseLayout
  title="PV-Rechner — Photovoltaik-Tools | Photovoltaik Aktuell"
  description="Alle Photovoltaik-Rechner von Photovoltaik Aktuell an einem Ort: PV-Rechner mit echten PVGIS-Daten, Speicher, Rendite, Balkonkraftwerk, CO2, Gestehungskosten, Reinigung, E-Auto, Steuer und Mieterstrom."
>
  <section class="container rechner-header">
    <Breadcrumb glieder={[{ name: "Rechner" }]} />
    <h1>Rechner</h1>
    <p>Konkrete Zahlen statt Schätzungen — für Ihr Dach, Ihren Verbrauch, Ihren Standort.</p>
  </section>

  <section class="container tool-grid">
    {tools.map((t) => (
      <a href={`/rechner/${t.slug}/`} class="tool-card">
        {SIGNET[t.slug] && (
          <span class="tool-signet">
            {(() => { const Signet = SIGNET[t.slug]; return <Signet size={40} />; })()}
          </span>
        )}
        <h2>{t.title}</h2>
        <p>{t.beschreibung}</p>
        <span class="tool-link">Jetzt rechnen →</span>
      </a>
    ))}
  </section>

  <section class="prose methodik">
    <h2>Womit gerechnet wird</h2>
    <p>
      Alle Rechner folgen derselben Regel: Kennzahlen kommen aus öffentlichen
      Quellen, werden nie geschönt, und jede Annahme wird auf der Seite
      ausgewiesen. Die wichtigsten Grundlagen:
    </p>
    <ul class="methodik-liste">
      <li>
        <strong>Ertrag:</strong> PVGIS-Satellitendaten des EU Joint Research
        Centre für Ihren Standort; ohne Standort der Bundesdurchschnitt
        von ca. 950 kWh/kWp je Jahr (Fraunhofer ISE).
      </li>
      <li>
        <strong>Preise:</strong> Fraunhofer-ISE- und Branchen-Marktpreisübersicht
        für Anlage und Speicher; inkl. Nullsteuersatz, d.h. brutto = netto.
      </li>
      <li>
        <strong>Strompreis:</strong> BDEW-Haushaltsdurchschnitt von 0,37 €/kWh;
        Vergütung nach § 49 EEG (Stand Bundesnetzagentur).
      </li>
      <li>
        <strong>Speicherdimensionierung:</strong> HTW-Berlin-Faustregel von
        1–1,2 kWh je 1.000 kWh Jahresverbrauch.
      </li>
      <li>
        <strong>Pflege:</strong> Die Datenprüfung läuft im selben Rhythmus wie
        die jährliche Aktualisierung der Artikel — die Annahmen sind in
        <tt>src/lib/calculate.js</tt> dokumentiert und zentral gepflegt.
      </li>
    </ul>
    <p class="methodik-hinweis">
      Ein Rechnergebnist ist eine Größenordnung für Ihre Planung, kein
      Angebot. Angebote für die konkrete Dachkonstruktion liefert ein
      Installateur.
    </p>
  </section>
</BaseLayout>

<style>
  /* Linksbündig auf Containerbreite wie das Kachelraster darunter. */
  .rechner-header {
    padding-block: 40px 24px;
  }

  .rechner-header h1 {
    font-size: 30px;
  }

  .rechner-header p {
    color: var(--color-text-secondary);
    font-size: 16px;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
    padding-bottom: 56px;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 24px 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  a.tool-card {
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }

  a.tool-card:hover {
    border-color: var(--color-accent);
  }

  /* Das Zeichen trägt Brand-Navy, nicht den Akzent: Orange bleibt dem
     Abschluss vorbehalten (eine Farbe, ein Zweck). Beim Überfahren der
     Karte wandert es mit der Rahmenfarbe auf Akzent — eine Bewegung,
     nicht elf. */
  .tool-signet {
    display: block;
    color: var(--color-brand-navy);
    margin-bottom: 14px;
    transition: color 0.15s;
  }

  a.tool-card:hover .tool-signet {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-signet,
    a.tool-card {
      transition: none;
    }
  }

  .tool-card h2 {
    font-size: 18px;
    margin: 0 0 8px;
  }

  .tool-card p {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 14px;
    flex-grow: 1;
  }

  .tool-link {
    font-weight: 600;
    font-size: 14px;
  }

  .methodik {
    max-width: 820px;
    padding: 8px 20px 64px;
  }

  .methodik h2 {
    font-size: 24px;
    margin-bottom: 0.5em;
  }

  .methodik p {
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.7;
  }

  .methodik-liste {
    margin: 18px 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .methodik-liste li {
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .methodik-liste strong {
    color: var(--color-text-primary);
  }

  .methodik-liste tt {
    font-size: 12.5px;
    background: var(--color-sky-subtle);
    padding: 1px 6px;
    border-radius: 4px;
    color: var(--color-brand-navy);
  }

  .methodik-hinweis {
    font-size: 13px;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
