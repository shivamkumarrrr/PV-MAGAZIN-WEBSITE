---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Wizard from "../../components/balkonkraftwerk/Wizard.jsx";
---

<BaseLayout
  title="Balkonkraftwerk-Rechner — Ertrag & Amortisation | PPC GmbH"
  description="Berechnen Sie Jahresertrag, Ersparnis und Amortisationszeit für Ihr Steckersolargerät — abgestimmt auf die 800-Watt-Regelung des Solarpakets I."
>
  <section class="prose rechner-intro">
    <nav class="breadcrumb"><a href="/rechner/">Rechner</a> / Balkonkraftwerk</nav>
    <h1>Balkonkraftwerk-Rechner</h1>
    <p>
      Zwei kurze Schritte, dann sehen Sie Jahresertrag, Eigenverbrauch,
      Ersparnis und Amortisationszeit für Ihr Steckersolargerät. Hintergrund
      zu Regeln und realistischen Erwartungen liefert der Artikel{" "}
      <a href="/ratgeber/balkonkraftwerk-einstieg-fuer-mieter/">
        Balkonkraftwerk: Der Einstieg in Photovoltaik für Mieter und kleine Budgets
      </a>
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  .rechner-intro {
    padding: 32px 20px 20px;
  }

  .breadcrumb {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
