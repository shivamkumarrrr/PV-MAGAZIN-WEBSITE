---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/mieterstrom/Wizard.jsx";
---

<BaseLayout
  title="Mieterstromrechner — PV im Mehrfamilienhaus | Photovoltaik Aktuell"
  description="Lohnt sich eine Photovoltaik-Anlage auf Ihrem Mehrfamilienhaus? Mieterstrom-Erlös, Zuschlag und Amortisation in einem berechnen."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "Mieterstrom" }]} />
    <h1>Mieterstromrechner</h1>
    <p>
      Eine PV-Anlage auf dem Dach eines Mehrfamilienhauses liefert Strom
      direkt an die Mieter — das Modell heißt Mieterstrom. Dieser Rechner gibt
      eine erste wirtschaftliche Einschätzung: Erlös an die Mieter,
      Mieterstromzuschlag, Einspeisung des Überschusses und die daraus
      resultierende Amortisation.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>