---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/eauto/Wizard.jsx";
---

<BaseLayout
  title="E-Auto-Laderechner — Mit PV günstig laden | Photovoltaik Aktuell"
  description="Was kostet Ihr E-Auto mit eigener Photovoltaik? Solarstromanteil, Ladekosten und passende PV-Größe in einem am eigenen Fahrprofil berechnen."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "E-Auto" }]} />
    <h1>E-Auto-Laderechner</h1>
    <p>
      Ein Elektroauto erhöht den Strombedarf Ihres Haushalts deutlich — und ist
      genau dann besonders günstig, wenn es tagsüber mit eigenem Solarstrom lädt.
      Dieser Rechner zeigt, wie viel Fahrstrom Sie aus der PV decken, was das
      Laden kostet und welche Anlagengröße zu Ihrem Fahrprofil passt.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
