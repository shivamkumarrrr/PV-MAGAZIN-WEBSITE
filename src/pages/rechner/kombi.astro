---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Wizard from "../../components/kombi/Wizard.jsx";
---

<BaseLayout
  title="PV + Wärmepumpe + E-Auto Rechner | Photovoltaik Aktuell"
  description="Wie sich Wärmepumpe, E-Auto und Speicher auf Eigenverbrauch, Autarkie und Amortisation Ihrer Photovoltaik-Anlage auswirken — Szenarien-Vergleich."
>
  <section class="prose rechner-intro">
    <nav class="breadcrumb"><a href="/rechner/">Rechner</a> / PV + Wärmepumpe + E-Auto</nav>
    <h1>Kombinations-Rechner</h1>
    <p>
      Eine Wärmepumpe und ein E-Auto erhöhen Ihren Stromverbrauch — und damit
      den Anteil, den Ihre PV-Anlage selbst abdecken kann. Dieser Rechner
      vergleicht verschiedene Kombinationen (PV allein, mit Speicher, mit
      Wärmepumpe, mit E-Auto, mit allem) direkt nebeneinander, damit Sie sehen,
      was sich für Ihren Haushalt lohnt.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  .rechner-intro {
    padding: 32px 20px 20px;
  }

  .breadcrumb {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
