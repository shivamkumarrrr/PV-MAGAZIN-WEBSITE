---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/kombi/Wizard.jsx";
---

<BaseLayout
  title="PV + Wärmepumpe + E-Auto Rechner | Photovoltaik Aktuell"
  description="Wie sich Wärmepumpe, E-Auto und Speicher auf Eigenverbrauch, Autarkie und Amortisation Ihrer Photovoltaik-Anlage auswirken — Szenarien-Vergleich."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "PV + Wärmepumpe + E-Auto" }]} />
    <h1>Kombinations-Rechner</h1>
    <p>
      Eine Wärmepumpe und ein E-Auto erhöhen Ihren Stromverbrauch — und damit
      den Anteil, den Ihre PV-Anlage selbst abdecken kann. Dieser Rechner
      vergleicht verschiedene Kombinationen (PV allein, mit Speicher, mit
      Wärmepumpe, mit E-Auto, mit allem) direkt nebeneinander, damit Sie sehen,
      was sich für Ihren Haushalt lohnt.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>
