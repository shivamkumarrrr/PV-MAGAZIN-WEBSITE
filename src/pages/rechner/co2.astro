---
// Hydration bewusst `client:load`, nicht `client:visible`: Der Rechner IST
// der Inhalt dieser Seite, kein Widget unterhalb des Falzes. Mit
// `client:visible` steht das serverseitig gerenderte Formular sichtbar da,
// reagiert aber noch nicht auf Klicks — genau daraus entsteht die Meldung
// "der Rechner funktioniert nicht". Die eingesparte Ladezeit ist den toten
// Klick nicht wert.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Wizard from "../../components/co2/Wizard.jsx";
---

<BaseLayout
  title="CO₂-Einsparungsrechner — Was spart Ihre PV? | Photovoltaik Aktuell"
  description="Wie viel CO₂ spart Ihre Photovoltaik-Anlage gegenüber dem deutschen Strommix? Berechnen Sie kg pro Jahr, über 25 Jahre und im Vergleich zu Auto & Bäumen."
>
  <section class="container rechner-intro">
    <Breadcrumb glieder={[{ name: "Rechner", href: "/rechner/" }, { name: "CO₂-Einsparung" }]} />
    <h1>CO₂-Einsparungsrechner</h1>
    <p>
      Jede Kilowattstunde, die Ihre Anlage erzeugt, ersetzt eine Kilowattstunde
      aus dem stark fossil geprägten Netzstrommix. Dieser Rechner zeigt, wie viel
      CO₂ Sie damit vermeiden — pro Jahr und über die Lebensdauer der Anlage,
      anschaulich gemacht im Vergleich zu Bäumen, Autofahrten und Zügen.
    </p>
  </section>

  <section class="container wizard-wrap">
    <Wizard client:load />
  </section>
</BaseLayout>

<style>
  /* Containerbreite statt schmaler, zentrierter Lesespalte: Der Rechner
     darunter steht im `.container` an der linken Seitenkante, ein
     zentrierter Kopf darüber begann 260px weiter rechts. `padding-block`,
     nicht die `padding`-Kurzform — sonst fallen die seitlichen 20px des
     Containers weg. */
  .rechner-intro {
    padding-block: 32px 20px;
  }


  .rechner-intro h1 {
    font-size: 28px;
  }

  .rechner-intro p {
    color: var(--color-text-secondary);
    font-size: 15px;
    max-width: 640px;
  }

  .rechner-intro a {
    color: var(--color-accent);
  }

  .wizard-wrap {
    padding-bottom: 56px;
  }
</style>